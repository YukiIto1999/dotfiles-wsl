+		let exchange = exchange.as_ref()?;
+		let client = if is_initialize {
+			exchange.clone()
+		} else {
+			self.client_key()?
+		};
+		Some((client, exchange.clone()))
+	}
+
+	/// Answers a discovery request from the memo and remembers it for the start-up check.
+	fn serve(
+		&self,
+		dormant: &mut Dormant,
+		req: &JsonRpcRequest<ClientRequest>,
+		exchange: Option<&str>,
+		is_initialize: bool,
+	) -> Option<ServerJsonRpcMessage> {
+		let exchange = exchange?;
+		let client = if is_initialize {
+			exchange.to_string()
+		} else {
+			self.client_key()?
+		};
+		let result = self.memo.trusted(&client, exchange)?;
+		let canonical = serde_json::to_value(&result).ok()?;
+		if is_initialize {
+			dormant.session.initialize = Some(req.request.clone());
+			dormant.session.initialize_served = Some(canonical);
+			dormant.session.served.clear();
+		} else {
+			dormant.session.served.push((req.request.clone(), canonical));
+		}
+		Some(ServerJsonRpcMessage::response(result, req.id.clone()))
+	}

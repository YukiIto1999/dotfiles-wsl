+/// 下流 GET 応答本文とセッションの idle 判定を対応付ける保持ガード
+///
+/// セッション表のロック成功時に限る生存ストリーム数減算と最終アクセス時刻更新
+/// 明示 DELETE 済みセッションの非再登録
+#[derive(Debug)]
+pub struct SessionStreamGuard {
+	sessions: Arc<RwLock<HashMap<String, SessionEntry>>>,
+	id: String,
+}
+
+impl Drop for SessionStreamGuard {
+	fn drop(&mut self) {
+		let Ok(mut sessions) = self.sessions.write() else {
+			return;
+		};
+		let Some(entry) = sessions.get_mut(&self.id) else {
+			return;
+		};
+		entry.active_streams = entry.active_streams.saturating_sub(1);
+		entry.last_access = Instant::now();
+	}
+}

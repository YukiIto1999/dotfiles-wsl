set +e

manifest=''
manifest_schema_version=2
report_schema_version=1
format=human

usage() {
  printf '%s\n' 'usage: dotfiles-doctor [--format human|json]' >&2
}

if [[ $# -gt 0 ]]; then
  if [[ $# -ne 2 || $1 != --format || ($2 != human && $2 != json) ]]; then
    usage
    exit 2
  fi
  format=$2
fi

report_tmp=$(mktemp -d)
checks_file="$report_tmp/checks.jsonl"
: > "$checks_file"

mcp_tmp=''
mcp_url=''
mcp_session=''
mcp_cleanup_protocol=''
mcp_cleanup_done=0
mcp_request_number=0
mcp_phase_failed=0
contract_error=0
legacy_check_index=0

add_check() {
  local id=$1 phase=$2 status=$3 subject=$4 expected=$5 observed=$6 message=$7 duration=$8
  jq -cn \
    --arg id "$id" \
    --arg phase "$phase" \
    --arg status "$status" \
    --arg subject "$subject" \
    --arg expected "$expected" \
    --arg observed "$observed" \
    --arg message "$message" \
    --argjson durationMs "$duration" \
    '{id:$id,phase:$phase,status:$status,subject:$subject,expected:$expected,observed:$observed,message:$message,durationMs:$durationMs}' \
    >> "$checks_file"
}
render_report() {
  local forced_status=${1-} checks summary outcome exit_status internal_message
  if ! checks=$(jq -s '.' "$checks_file") || ! jq -e '
    type == "array" and length > 0 and
    all(.[];
      (.id | type) == "string" and (.id | length) > 0 and
      (.phase == "foundation" or .phase == "local" or .phase == "system" or .phase == "active") and
      (.status == "pass" or .status == "warn" or .status == "fail" or .status == "error" or .status == "blocked") and
      (.subject | type) == "string" and
      (.expected | type) == "string" and
      (.observed | type) == "string" and
      (.message | type) == "string" and (.message | length) > 0 and
      (.durationMs | type) == "number" and .durationMs >= 0 and (.durationMs | floor) == .durationMs
    ) and
    ([.[].id] | length) == ([.[].id] | unique | length)
  ' <<< "$checks" >/dev/null 2>&1; then
    internal_message='doctor result core violates its internal contract'
    contract_error=1
    checks=$(jq -cn --arg message "$internal_message" '[{
      id:"internal.report",phase:"foundation",status:"error",subject:"result-core",
      expected:"valid unique checks",observed:"invalid",message:$message,durationMs:0
    }]')
  fi
  summary=$(jq -cn --argjson checks "$checks" '{
    total: ($checks | length),
    pass: ([$checks[] | select(.status == "pass")] | length),
    warn: ([$checks[] | select(.status == "warn")] | length),
    fail: ([$checks[] | select(.status == "fail")] | length),
    error: ([$checks[] | select(.status == "error")] | length),
    blocked: ([$checks[] | select(.status == "blocked")] | length)
  }')

  if [[ $forced_status == 2 || $contract_error -eq 1 ]] || jq -e '.error > 0' <<< "$summary" >/dev/null; then
    outcome=invalid
    exit_status=2
  elif jq -e '.fail > 0 or .blocked > 0' <<< "$summary" >/dev/null; then
    outcome=degraded
    exit_status=1
  else
    outcome=healthy
    exit_status=0
  fi

  if [[ $format == json ]]; then
    jq -cn \
      --argjson schemaVersion "$report_schema_version" \
      --argjson manifestSchemaVersion "$manifest_schema_version" \
      --arg outcome "$outcome" \
      --argjson summary "$summary" \
      --argjson checks "$checks" \
      '{schemaVersion:$schemaVersion,manifestSchemaVersion:$manifestSchemaVersion,outcome:$outcome,summary:$summary,checks:$checks}'
  else
    jq -r '.[] | (if .status == "pass" then "OK" elif .status == "warn" then "WARN" elif .status == "fail" then "FAIL" elif .status == "error" then "ERROR" else "SKIP" end) + ": " + .message' <<< "$checks"
  fi
  return "$exit_status"
}

mcp_remove_temp() {
  if [[ -n $mcp_tmp ]]; then
    rm -rf -- "$mcp_tmp"
    mcp_tmp=''
  fi
}

# EXIT trap から関数名で呼び出す。
# shellcheck disable=SC2329
cleanup_all() {
  local status=$?
  if declare -F mcp_cleanup_session >/dev/null; then
    mcp_cleanup_session >/dev/null 2>&1
  fi
  mcp_remove_temp
  rm -rf -- "$report_tmp"
  return "$status"
}

# INT / TERM trap から関数名で呼び出す。
# shellcheck disable=SC2329
signal_exit() {
  local status=$1
  trap - INT TERM
  if declare -F mcp_cleanup_session >/dev/null; then
    mcp_cleanup_session >/dev/null 2>&1
  fi
  mcp_remove_temp
  rm -rf -- "$report_tmp"
  exit "$status"
}

trap cleanup_all EXIT
trap 'signal_exit 130' INT
trap 'signal_exit 143' TERM

manifest="@doctorManifestPath@"

record_legacy_check() {
  local status=$1 message=$2
  legacy_check_index=$((legacy_check_index + 1))
  add_check "legacy.$legacy_check_index" active "$status" legacy-probe legacy-result \
    "$status" "$message" 0
}

ok() { record_legacy_check pass "$*"; }
warn() { record_legacy_check warn "$*"; }
bad() { record_legacy_check fail "$*"; }

if [[ ! -r $manifest ]]; then
  bad "doctor manifest is not readable: $manifest"
  render_report; exit $?
fi

if ! jq -e '
  .schemaVersion == 2 and
  (.user.name | type) == "string" and
  (.user.home | type) == "string" and
  (.generation.current | type) == "string" and
  (.generation.booted | type) == "string" and
  (.generation.profile | type) == "string" and
  (.sops.rootProbe | type) == "string" and
  (.sops.homeKey.path | type) == "string" and
  (.sops.homeKey.policy == "warn" or .sops.homeKey.policy == "reject") and
  (.units | type) == "array" and
  all(.units[]; type == "string") and
  (.managedFiles | type) == "array" and
  all(.managedFiles[];
    (.path | type) == "string" and
    (.source | type) == "string"
  ) and
  (.clis | type) == "array" and
  all(.clis[];
    (.name | type) == "string" and
    (.binaryName | type) == "string" and
    (.binaryPath | type) == "string" and
    (.rules.path | type) == "string" and
    (.rules.source | type) == "string" and
    (.skills.directory | type) == "string" and
    (.skills.names | type) == "array" and
    all(.skills.names[]; type == "string") and
    (.agents == null or (
      (.agents.directory | type) == "string" and
      (.agents.files | type) == "array" and
      all(.agents.files[]; type == "string")
    )) and
    (.gatewayFile == null or (
      (.gatewayFile.path | type) == "string" and
      (.gatewayFile.contains | type) == "string"
    ))
  ) and
  (.mcp | type) == "object" and
  (.mcp.url | type) == "string" and
  (.mcp.targets | type) == "array" and
  all(.mcp.targets[]; type == "string") and
  (.mcp.requestedProtocolVersion | type) == "string" and
  (.mcp.supportedProtocolVersions | type) == "array" and
  all(.mcp.supportedProtocolVersions[]; type == "string") and
  (.wslInterop.launcherName | type) == "string" and
  (.wslInterop.launcherPath | type) == "string" and
  (.wslInterop.launcherSource | type) == "string" and
  (.wslInterop.windowsCommand | type) == "string" and
  (.nixLdPath | type) == "string"
' "$manifest" >/dev/null 2>&1; then
  bad "doctor manifest does not match schema version 2: $manifest"
  render_report; exit $?
fi

current=$(jq -r '.generation.current' "$manifest")
booted=$(jq -r '.generation.booted' "$manifest")
profile=$(jq -r '.generation.profile' "$manifest")

current_canonical=$(readlink -e -- "$current" 2>/dev/null)
if [[ -z $current_canonical ]]; then
  bad "current generation cannot be resolved: $current"
fi

profile_canonical=$(readlink -e -- "$profile" 2>/dev/null)
if [[ -z $profile_canonical ]]; then
  bad "system profile cannot be resolved: $profile"
elif [[ -n $current_canonical && $profile_canonical != "$current_canonical" ]]; then
  bad "system profile does not match current generation"
else
  ok "system profile matches current generation"
fi

running_canonical=$(readlink -e -- "$0" 2>/dev/null)
expected_doctor_canonical=''
if [[ -n $current_canonical ]]; then
  expected_doctor_canonical=$(readlink -e -- "$current/sw/bin/dotfiles-doctor" 2>/dev/null)
fi

if [[ -z $running_canonical ]]; then
  bad "running doctor cannot be resolved: $0"
elif [[ -z $expected_doctor_canonical ]]; then
  bad "current generation doctor cannot be resolved: $current/sw/bin/dotfiles-doctor"
elif [[ $running_canonical != "$expected_doctor_canonical" ]]; then
  bad "running doctor does not match current generation"
else
  ok "running doctor matches current generation"
fi

effect=$(dotfiles-wsl-restart-required \
  --plan \
  --booted-system "$booted" \
  --current-system "$current" \
  "$current" 2>/dev/null)
effect_status=$?
if [[ $effect_status -ne 0 || -z $effect ]]; then
  bad "WSL cold-start state could not be classified"
elif [[ $effect != switch ]]; then
  bad "WSL cold-start state requires $effect"
else
  ok "WSL cold-start state is current"
fi

while IFS= read -r unit; do
  load_state=$(systemctl show --property=LoadState --value "$unit" 2>/dev/null)
  load_status=$?
  if [[ $load_status -ne 0 || -z $load_state ]]; then
    bad "$unit LoadState could not be queried"
  elif [[ $load_state != loaded ]]; then
    bad "$unit LoadState is not loaded: $load_state"
  else
    ok "$unit is loaded"
  fi

  active_state=$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null)
  active_status=$?
  if [[ $active_status -ne 0 || -z $active_state ]]; then
    bad "$unit ActiveState could not be queried"
  elif [[ $active_state != active ]]; then
    bad "$unit ActiveState is not active: $active_state"
  else
    ok "$unit is active"
  fi
done < <(jq -r '.units[]' "$manifest")

root_probe=$(jq -r '.sops.rootProbe' "$manifest")
root_metadata=$(sudo -n -- "$root_probe" 2>/dev/null)
root_probe_status=$?
if [[ $root_probe_status -eq 0 ]] && jq -e '
  .directory.uid == 0 and
  .directory.gid == 0 and
  .directory.mode == "700" and
  .key.uid == 0 and
  .key.gid == 0 and
  .key.mode == "400"
' <<< "$root_metadata" >/dev/null 2>&1; then
  ok "SOPS host key metadata matches root policy"
else
  bad "SOPS host key metadata does not match root policy"
fi

home_key=$(jq -r '.sops.homeKey.path' "$manifest")
home_key_policy=$(jq -r '.sops.homeKey.policy' "$manifest")
if [[ -e $home_key || -L $home_key ]]; then
  if [[ $home_key_policy == reject ]]; then
    bad "user SOPS age key must not exist after migration"
  else
    warn "user SOPS age key still exists during migration"
  fi
else
  ok "user SOPS age key is absent"
fi

while IFS= read -r managed_file; do
  path=$(jq -r '.path' <<< "$managed_file")
  source=$(jq -r '.source' <<< "$managed_file")
  if cmp --silent -- "$path" "$source" 2>/dev/null; then
    ok "managed file is current: $path"
  else
    bad "managed file is stale: $path"
  fi
done < <(jq -c '.managedFiles[]' "$manifest")

while IFS= read -r cli; do
  name=$(jq -r '.name' <<< "$cli")
  binary_name=$(jq -r '.binaryName' <<< "$cli")
  binary_path=$(jq -r '.binaryPath' <<< "$cli")

  if [[ -x $binary_path ]]; then
    ok "$name CLI is executable"
  else
    bad "CLI is not executable: $binary_path"
  fi

  resolved_binary=$(type -P -- "$binary_name" 2>/dev/null)
  if [[ $resolved_binary != "$binary_path" ]]; then
    bad "$binary_name does not resolve to $binary_path"
  else
    ok "$binary_name resolves to $binary_path"
  fi

  version=$(timeout 5s "$binary_path" --version 2>/dev/null)
  version_status=$?
  if [[ $version_status -eq 0 && -n $version ]]; then
    ok "$binary_name version check passed"
  else
    bad "$binary_name version check failed"
  fi

  rules_path=$(jq -r '.rules.path' <<< "$cli")
  rules_source=$(jq -r '.rules.source' <<< "$cli")
  if cmp --silent -- "$rules_path" "$rules_source" 2>/dev/null; then
    ok "$name rules file is current"
  else
    bad "$name rules file is stale: $rules_path"
  fi

  skills_directory=$(jq -r '.skills.directory' <<< "$cli")
  while IFS= read -r skill_name; do
    skill_file="$skills_directory/$skill_name/SKILL.md"
    if [[ -f $skill_file ]]; then
      ok "$name skill is deployed: $skill_name"
    else
      bad "$name skill is missing: $skill_file"
    fi
  done < <(jq -r '.skills.names[]' <<< "$cli")

  agents_directory=$(jq -r '.agents.directory // empty' <<< "$cli")
  if [[ -n $agents_directory ]]; then
    while IFS= read -r agent_file; do
      agent_path="$agents_directory/$agent_file"
      if [[ -f $agent_path ]]; then
        ok "$name agent is deployed: $agent_file"
      else
        bad "$name agent is missing: $agent_path"
      fi
    done < <(jq -r '.agents.files[]' <<< "$cli")
  fi

  gateway_path=$(jq -r '.gatewayFile.path // empty' <<< "$cli")
  gateway_contains=$(jq -r '.gatewayFile.contains // empty' <<< "$cli")
  if [[ -n $gateway_path ]]; then
    if [[ -n $gateway_contains ]] && grep -qF -- "$gateway_contains" "$gateway_path" 2>/dev/null; then
      ok "$name gateway file is current"
    else
      bad "$name gateway file is missing or stale: $gateway_path"
    fi
  fi
done < <(jq -c '.clis[]' "$manifest")

wsl_launcher_name=$(jq -r '.wslInterop.launcherName' "$manifest")
wsl_launcher_path=$(jq -r '.wslInterop.launcherPath' "$manifest")
wsl_launcher_source=$(jq -r '.wslInterop.launcherSource' "$manifest")
wsl_launcher_canonical=$(readlink -e -- "$wsl_launcher_path" 2>/dev/null)
wsl_launcher_source_canonical=$(readlink -e -- "$wsl_launcher_source" 2>/dev/null)
if [[ -x $wsl_launcher_path \
  && -n $wsl_launcher_canonical \
  && $wsl_launcher_canonical == "$wsl_launcher_source_canonical" ]]; then
  ok "WSL launcher is current: $wsl_launcher_path"
else
  bad "WSL launcher is missing or stale: $wsl_launcher_path"
fi

resolved_wsl_launcher=$(type -P -- "$wsl_launcher_name" 2>/dev/null)
if [[ $resolved_wsl_launcher == "$wsl_launcher_path" ]]; then
  ok "$wsl_launcher_name resolves to $wsl_launcher_path"
else
  bad "$wsl_launcher_name does not resolve to $wsl_launcher_path"
fi

windows_command=$(jq -r '.wslInterop.windowsCommand' "$manifest")
if [[ ! -x $windows_command ]]; then
  bad "Windows interop command is not executable: $windows_command"
else
  timeout 5s "$windows_command" /d /c exit 0 >/dev/null 2>&1
  windows_probe_status=$?
  if [[ $windows_probe_status -eq 0 ]]; then
    ok "Windows interop probe passed"
  else
    bad "Windows interop probe failed: $windows_command"
  fi
fi

check_mcp() {
  local requested_protocol initialize_payload initialized_payload
  local mcp_phase_failed=0 mcp_request_id=2 page_count=0
  local has_next_cursor=0 next_cursor='' cursor_key
  local all_tools='[]' target prefix
  declare -A seen_cursors=()

  mcp_url=$(jq -r '.mcp.url' "$manifest")
  requested_protocol=$(jq -r '.mcp.requestedProtocolVersion' "$manifest")
  mcp_cleanup_protocol=$requested_protocol
  initialize_payload=$(jq -cn \
    --arg protocol "$requested_protocol" \
    '{
      jsonrpc: "2.0",
      id: 1,
      method: "initialize",
      params: {
        protocolVersion: $protocol,
        capabilities: {},
        clientInfo: {name: "dotfiles-doctor", version: "1"}
      }
    }')

  mcp_request POST "$mcp_url" "$initialize_payload" '' ''

  if [[ $mcp_curl_status -ne 0 ]]; then
    bad "MCP initialize request failed"
    mcp_phase_failed=1
  elif [[ $mcp_http_status != 200 ]]; then
    bad "MCP initialize failed with HTTP $mcp_http_status"
    mcp_phase_failed=1
  elif ! mcp_parse_response 1; then
    if [[ $mcp_parse_error == content-type ]]; then
      bad "MCP initialize response has unsupported content type: $mcp_content_type"
    else
      bad "MCP initialize response has an invalid JSON-RPC envelope"
    fi
    mcp_phase_failed=1
  else
    mcp_protocol=$(jq -r '.result.protocolVersion // empty' <<< "$mcp_response_json" 2>/dev/null)
    if [[ -n $mcp_protocol ]]; then
      mcp_cleanup_protocol=$mcp_protocol
    fi

    if ! jq -e '
      .jsonrpc == "2.0" and
      .id == 1 and
      (.result | type) == "object" and
      (.result.protocolVersion | type) == "string" and
      (.result.capabilities | type) == "object"
    ' <<< "$mcp_response_json" >/dev/null 2>&1; then
      bad "MCP initialize response has an invalid JSON-RPC envelope"
      mcp_phase_failed=1
    elif ! jq -e '(.result.capabilities.tools | type) == "object"' \
      <<< "$mcp_response_json" >/dev/null 2>&1; then
      bad "MCP initialize response does not advertise tools capability"
      mcp_phase_failed=1
    elif [[ -z $mcp_session ]]; then
      bad "MCP initialize response is missing a session ID"
      mcp_phase_failed=1
    elif ! jq -e --arg protocol "$mcp_protocol" \
      '.mcp.supportedProtocolVersions | index($protocol) != null' \
      "$manifest" >/dev/null 2>&1; then
      bad "MCP negotiated unsupported protocol version: $mcp_protocol"
      mcp_phase_failed=1
    fi
  fi

  if [[ $mcp_phase_failed -eq 0 ]]; then
    initialized_payload='{"jsonrpc":"2.0","method":"notifications/initialized"}'
    mcp_request POST "$mcp_url" "$initialized_payload" "$mcp_session" "$mcp_protocol"
    if [[ $mcp_curl_status -ne 0 ]]; then
      bad "MCP initialized notification request failed"
      mcp_phase_failed=1
    elif [[ $mcp_http_status != 202 ]]; then
      bad "MCP initialized notification failed with HTTP $mcp_http_status"
      mcp_phase_failed=1
    fi
  fi

  while [[ $mcp_phase_failed -eq 0 ]]; do
    local tools_payload tools_page
    if [[ $page_count -ge 100 ]]; then
      bad "MCP tools/list pagination exceeded 100 pages"
      mcp_phase_failed=1
      break
    fi

    if [[ $has_next_cursor -eq 0 ]]; then
      tools_payload=$(jq -cn \
        --argjson id "$mcp_request_id" \
        '{jsonrpc:"2.0",id:$id,method:"tools/list",params:{}}')
    else
      tools_payload=$(jq -cn \
        --argjson id "$mcp_request_id" \
        --arg cursor "$next_cursor" \
        '{jsonrpc:"2.0",id:$id,method:"tools/list",params:{cursor:$cursor}}')
    fi

    mcp_request POST "$mcp_url" "$tools_payload" "$mcp_session" "$mcp_protocol"
    if [[ $mcp_curl_status -ne 0 ]]; then
      bad "MCP tools/list request failed"
      mcp_phase_failed=1
      break
    elif [[ $mcp_http_status != 200 ]]; then
      bad "MCP tools/list failed with HTTP $mcp_http_status"
      mcp_phase_failed=1
      break
    elif ! mcp_parse_response "$mcp_request_id"; then
      bad "MCP tools/list response is invalid"
      mcp_phase_failed=1
      break
    elif ! jq -e --argjson id "$mcp_request_id" '
      .jsonrpc == "2.0" and
      .id == $id and
      (.result | type) == "object" and
      (.result.tools | type) == "array" and
      all(.result.tools[]; (.name | type) == "string") and
      (.result.nextCursor == null or (.result.nextCursor | type) == "string")
    ' <<< "$mcp_response_json" >/dev/null 2>&1; then
      bad "MCP tools/list response is invalid"
      mcp_phase_failed=1
      break
    fi

    tools_page=$(jq -c '.result.tools' <<< "$mcp_response_json")
    all_tools=$(jq -cn \
      --argjson existing "$all_tools" \
      --argjson page "$tools_page" \
      '$existing + $page')
    if jq -e '.result | has("nextCursor") and .nextCursor != null' \
      <<< "$mcp_response_json" >/dev/null 2>&1; then
      has_next_cursor=1
      next_cursor=$(jq -r '.result.nextCursor' <<< "$mcp_response_json")
    else
      has_next_cursor=0
      next_cursor=''
    fi
    page_count=$((page_count + 1))
    mcp_request_id=$((mcp_request_id + 1))

    if [[ $has_next_cursor -eq 0 ]]; then
      break
    fi

    cursor_key="cursor:$next_cursor"
    if [[ -n ${seen_cursors[$cursor_key]+x} ]]; then
      bad "MCP tools/list pagination cursor repeated"
      mcp_phase_failed=1
      break
    fi
    seen_cursors[$cursor_key]=1
  done

  if [[ $mcp_phase_failed -eq 0 ]]; then
    while IFS= read -r target; do
      prefix="${target}_"
      if jq -e --arg prefix "$prefix" \
        'any(.[]; .name | startswith($prefix))' \
        <<< "$all_tools" >/dev/null 2>&1; then
        ok "MCP target exposes tools: $target"
      else
        bad "MCP target has no tools: $target"
        mcp_phase_failed=1
      fi
    done < <(jq -r '.mcp.targets[]' "$manifest")
  fi

  if ! mcp_cleanup_session; then
    mcp_phase_failed=1
  fi

  if [[ $mcp_phase_failed -eq 0 ]]; then
    ok "MCP session lifecycle completed"
  fi
}

mcp_request() {
  local method=$1 url=$2 payload=$3 session=$4 protocol=$5
  local -a curl_args

  mcp_request_number=$((mcp_request_number + 1))
  mcp_headers_file="$mcp_tmp/headers-$mcp_request_number"
  mcp_body_file="$mcp_tmp/body-$mcp_request_number"
  curl_args=(
    --silent
    --show-error
    --max-time 5
    --request "$method"
    --header 'Accept: application/json, text/event-stream'
    --dump-header "$mcp_headers_file"
    --output "$mcp_body_file"
    --write-out '%{http_code}'
  )
  if [[ -n $payload ]]; then
    curl_args+=(
      --header 'Content-Type: application/json'
      --data "$payload"
    )
  fi
  if [[ -n $session ]]; then
    curl_args+=(--header "Mcp-Session-Id: $session")
  fi
  if [[ -n $protocol ]]; then
    curl_args+=(--header "MCP-Protocol-Version: $protocol")
  fi
  curl_args+=("$url")

  mcp_http_status=$(curl "${curl_args[@]}")
  mcp_curl_status=$?
  mcp_response_session=''
  mcp_content_type=''
  mcp_response_json=''

  if [[ -r $mcp_headers_file ]]; then
    while IFS= read -r header_line; do
      header_line=${header_line%$'\r'}
      case ${header_line,,} in
        mcp-session-id:*)
          mcp_response_session=${header_line#*:}
          mcp_response_session=${mcp_response_session# }
          ;;
        content-type:*)
          mcp_content_type=${header_line#*:}
          mcp_content_type=${mcp_content_type# }
          ;;
      esac
    done < "$mcp_headers_file"
  fi

  if [[ $method == POST && -z $session && -n $mcp_response_session ]]; then
    mcp_session=$mcp_response_session
  fi
}

mcp_cleanup_session() {
  if [[ $mcp_cleanup_done -eq 1 ]]; then
    return 0
  fi
  mcp_cleanup_done=1

  if [[ -z $mcp_session ]]; then
    return 0
  fi

  mcp_request DELETE "$mcp_url" '' "$mcp_session" "$mcp_cleanup_protocol"
  if [[ $mcp_curl_status -ne 0 ]]; then
    bad "MCP session cleanup request failed"
    return 1
  elif [[ ! $mcp_http_status =~ ^2[0-9][0-9]$ ]]; then
    bad "MCP session cleanup failed with HTTP $mcp_http_status"
    return 1
  fi
  return 0
}

mcp_parse_response() {
  local expected_id=$1 content_type_lower=${mcp_content_type,,}
  local line event_data=''
  mcp_parse_error=body
  case $content_type_lower in
    application/json*)
      mcp_response_json=$(< "$mcp_body_file")
      if [[ -n $mcp_response_json ]] && jq -e -s 'length == 1' \
        <<< "$mcp_response_json" >/dev/null 2>&1; then
        return 0
      fi
      ;;
    text/event-stream*)
      while IFS= read -r line; do
        line=${line%$'\r'}
        if [[ -z $line ]]; then
          if mcp_select_sse_response "$expected_id" "$event_data"; then
            return 0
          fi
          event_data=''
        elif [[ $line == data:* ]]; then
          line=${line#data:}
          line=${line# }
          if [[ -n $event_data ]]; then
            event_data+=$'\n'
          fi
          event_data+=$line
        fi
      done < "$mcp_body_file"
      if mcp_select_sse_response "$expected_id" "$event_data"; then
        return 0
      fi
      ;;
    *)
      mcp_parse_error=content-type
      return 1
      ;;
  esac

  return 1
}

mcp_select_sse_response() {
  local expected_id=$1 event_data=$2
  [[ -n $event_data ]] || return 1
  if jq -e -s --argjson id "$expected_id" \
    'length == 1 and .[0].jsonrpc == "2.0" and .[0].id == $id' \
    <<< "$event_data" >/dev/null 2>&1; then
    mcp_response_json=$event_data
    return 0
  fi
  return 1
}


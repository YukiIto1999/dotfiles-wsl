mcp_request_number=0
mcp_http_status=''
mcp_curl_status=0
mcp_headers_file=''
mcp_body_file=''
mcp_response_session=''
mcp_content_type=''
mcp_response_json=''
mcp_parse_error=''
mcp_url=''
mcp_session=''
mcp_protocol=''
mcp_cleanup_protocol=''
mcp_cleanup_done=0
check_mcp
mcp_remove_temp

nix_ld_path=$(jq -r '.nixLdPath' "$manifest")
if [[ -e $nix_ld_path ]]; then
  ok "nix-ld dynamic linker path exists"
else
  bad "nix-ld dynamic linker path is missing: $nix_ld_path"
fi

  render_report; exit $?

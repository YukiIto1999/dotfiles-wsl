+/// SessionStreamGuard keeps a session out of the idle reaper while a downstream GET body is alive.
+/// Dropping it releases the stream and restarts the idle clock from that moment. A session removed
+/// by an explicit DELETE is not resurrected.
+#[derive(Debug)]
+pub struct SessionStreamGuard {
+	sessions: Arc<RwLock<HashMap<String, SessionEntry>>>,
+	id: String,
+}
+
+impl Drop for SessionStreamGuard {
+	fn drop(&mut self) {
+		let Ok(mut sessions) = self.sessions.write() else {
+			return;
+		};
+		// A session removed by an explicit DELETE stays removed; the guard never re-inserts it.
+		let Some(entry) = sessions.get_mut(&self.id) else {
+			return;
+		};
+		entry.active_streams = entry.active_streams.saturating_sub(1);
+		entry.last_access = Instant::now();
+	}
+}

+		contradicted.relisted(&live_first.0, &live_first.1);
+		assert!(!refused(&contradicted, "a"));
+		assert!(refused(&contradicted, "c"));
+		contradicted.relisted(&live_next.0, &live_next.1);
+		assert!(
+			contradicted.is_empty(),
+			"listing every page again leaves nothing contradicted"
+		);
+	}

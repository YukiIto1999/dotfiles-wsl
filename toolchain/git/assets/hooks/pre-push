#!/usr/bin/env bash
set -euo pipefail

# stashやcheckoutによるsource切替の不採用: 検証のための利用者のworktree変更の回避
verification_entry=@verificationEntry@
within=@runWithin@
budget_seconds=
# 検査本体の走行が目標へ達した時点の読取を残す秒。宣言していなければ空。目標は記録するだけで、取消にも判定にも使わない
feedback_target=
bypass_log=$HOME/.local/state/dotfiles-wsl/git/verify-push-bypass.log
difference_lines=10

duration() {
  printf '%d分%02d秒' $(($1 / 60)) $(($1 % 60))
}

refuse() {
  printf 'verify-push: %s\n' "$*" >&2
  exit 1
}

# 利用者が理由を添えて検証を省いた push を、後から辿れるように控える。
record_bypass() {
  local top=$1 entry=$2 reason=$3 head
  head=$(git -C "$top" rev-parse --verify -q HEAD || printf 'none')
  mkdir -p "${bypass_log%/*}"
  printf '%s\trepo=%s\thead=%s\tentry=%s\treason=%s\n' \
    "$(date -Iseconds)" "$top" "$head" "$entry" "$reason" >>"$bypass_log"
  printf 'verify-push: %s を省いた。理由: %s(%s に記録した)\n' "$entry" "$reason" "$bypass_log" >&2
}

commit_of() {
  git -C "$1" rev-parse --verify -q "$2^{commit}" || true
}

# commit解決の空同士を一致とする判定の不採用: HEAD未作成とcommitでないobjectの誤受理の回避
is_head() {
  [ -n "$2" ] && [ "$(commit_of "$1" "$3")" = "$2" ]
}

refuse_lines() {
  local lines=$1 message=$2
  local -a shown
  [ -n "$lines" ] || return 0
  mapfile -t -n "$difference_lines" shown <<<"$lines"
  {
    printf 'verify-push: %s\n' "$message"
    printf '  %s\n' "${shown[@]}"
  } >&2
  exit 1
}

# statusの任意lock取得の不採用: 並行するindex操作との競合の回避
require_clean_source() {
  local top=$1 consequence=$2 difference flags
  difference=$(git -C "$top" --no-optional-locks status --porcelain --untracked-files=all --ignore-submodules=none) \
    || refuse "source の status 検査に失敗した。$consequence"
  refuse_lines "$difference" "index、作業木、未追跡に差分がある。$consequence"
  # statusだけでのclean判定の不採用: submoduleを含むindexのassume-unchangedとskip-worktreeの不可視性
  flags=$(git -C "$top" ls-files -v --recurse-submodules) \
    || refuse "source の index flag 検査に失敗した。$consequence"
  refuse_lines "$(grep -v '^H ' <<<"$flags" || true)" \
    "検査できない index の印(assume-unchanged、skip-worktree、unmerged)を持つ path がある。$consequence"
}

require_unchanged_source() {
  local top=$1 head=$2
  if [ "$(commit_of "$top" HEAD)" != "$head" ]; then
    refuse "検査の間に HEAD が $head から動いた。通った検査は送る commit のものではない"
  fi
  require_clean_source "$top" "検査の間に source が動いた。通った検査は送る commit のものではない"
}

# git が hook へ渡す GIT_DIR などを入口へ渡すと、入口の中で一時 repository に向けた git の操作が
# push 元の repository を書き換えるため、git の repository 固有の環境変数を外して起動する。
# 起動する subshell の中で呼び、その subshell の環境だけを変える。
without_git_environment() {
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)
}

budget_left() {
  local left=$((budget_seconds - (SECONDS - started)))
  if [ "$left" -le 0 ]; then
    printf 'verify-push: 次の処理を始める前に時間予算を使い切った\n' >&2
    return 124
  fi
  printf '%d' "$left"
}

# 資源の入場に待った秒数を予算から外す。予算は走行の枠で、待ちは別の上限（走行の秒数と同じ）で数える
# 引数: 待った秒数を supervise が残した結果の file
# 副作用: 予算の起点を待った秒数だけ進める。読めなければ進めない
settle_wait() {
  local waited
  waited=$(jq -r '(.waitSeconds // 0) | ceil' "$1" 2>/dev/null) || waited=0
  [[ $waited =~ ^[0-9]+$ ]] || waited=0
  started=$((started + waited))
}

# 引数: [--resource-key KEY] TOP COMMAND...
# 鍵を渡した呼出しだけが資源予約へ入場し、無ければ入場せず待たない。鍵は需要を実測の記録から決める検査本体にだけ渡す
# 目標も鍵を渡した呼出しにだけ付ける。目標の時点の読取は資源予約を持つ走行の scope にしか無い
run_within_budget() {
  local -a resource_key=()
  local top pid status remaining result=
  remaining=$(budget_left) || return $?
  if [ "$1" = --resource-key ]; then
    result=$(mktemp)
    resource_key=(--resource-key "$2" --result "$result")
    [ -z "$feedback_target" ] || resource_key+=(--resource-target-seconds "$feedback_target")
    shift 2
  fi
  top=$1
  shift
  (cd "$top" && without_git_environment && exec "$within" "${resource_key[@]}" "$remaining" "$@") </dev/null &
  pid=$!
  trap 'interrupted=1; kill -TERM "$pid" 2>/dev/null || true' INT TERM HUP
  while :; do
    status=0
    wait "$pid" || status=$?
    # signal で中断された wait は job の終了を待たずに戻る。job が残っていれば待ち直す
    kill -0 "$pid" 2>/dev/null || break
  done
  trap - INT TERM HUP
  if [ -n "$result" ]; then
    settle_wait "$result"
    if [ "$status" -eq 0 ] && ! jq -es 'length == 1 and (.[0] |
      .phase == "finished" and .spawned == true and .drained == true and
      .cancelled == false and .client_status == 0 and .status == 0)' "$result" >/dev/null; then
      rm -f -- "$result"
      refuse '監督器の記録で取消のない正常終了を確認できないため push を認めない'
    fi
    rm -f -- "$result"
  fi
  return "$status"
}

resolve_entry() {
  local top=$1
  if [ -z "$budget_seconds" ]; then
    (cd "$top" && without_git_environment && exec "$verification_entry" --repo "$top" --policy "$policy_file" verify-push) </dev/null
    return
  fi
  run_within_budget "$top" "$verification_entry" --repo "$top" --policy "$policy_file" verify-push
}

require_run_success() {
  local status=$1 phase=$2 elapsed=$((SECONDS - started))
  if [ "$interrupted" -eq 1 ]; then
    printf 'verify-push: %sを中断した(経過 %s)\n' "$phase" "$(duration "$elapsed")" >&2
    exit 130
  fi
  if [ "$status" -ne 0 ]; then
    printf 'verify-push: %sの呼び出しが終了 %d で戻った(経過 %s)\n' "$phase" "$status" "$(duration "$elapsed")" >&2
    exit "$status"
  fi
  if [ -n "$budget_seconds" ] && [ "$elapsed" -ge "$budget_seconds" ]; then
    printf 'verify-push: %sの終了時には予算 %s に達していた(経過 %s)。push を認めない\n' \
      "$phase" "$(duration "$budget_seconds")" "$(duration "$elapsed")" >&2
    exit 1
  fi
}

main() {
  local top entry entry_file policy_file head ref object budget_error='' budget_result target_result started=$SECONDS elapsed status=0 interrupted=0 resource_key
  local -a command pushed=() stale=()
  top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
  # 削除refへのHEAD一致要求の不採用: Gitがlocal objectとして渡すゼロ値
  head=$(commit_of "$top" HEAD)
  object=
  while read -r ref object _ _ || [ -n "$object" ]; do
    if [[ $object =~ ^0+$ ]]; then
      continue
    fi
    pushed+=("$ref")
    if ! is_head "$top" "$head" "$object"; then
      stale+=("$ref")
    fi
  done
  [ "${#pushed[@]}" -gt 0 ] || exit 0
  entry_file=$(mktemp)
  policy_file=$(mktemp)
  trap 'rm -f -- "$entry_file" "$policy_file"' EXIT
  if budget_error=$(
    (cd "$top" && without_git_environment &&
      exec "$verification_entry" --repo "$top" --snapshot verify-push) 2>&1 >"$policy_file"
  ); then
    if budget_result=$("$verification_entry" --repo "$top" --policy "$policy_file" --budget verify-push 2>&1) \
      && [[ $budget_result =~ ^[1-9][0-9]*$ ]]; then
      budget_seconds=$budget_result
      # 目標は上限と同じ snapshot から読む。不正な目標は上限の不正と同じく、補完も無視もせず予算を決められない扱いにする
      if target_result=$("$verification_entry" --repo "$top" --policy "$policy_file" --feedback-target verify-push 2>&1) \
        && [[ $target_result =~ ^([1-9][0-9]*)?$ ]]; then
        feedback_target=$target_result
      else
        budget_seconds=
        budget_error=$target_result
      fi
    else
      budget_error=$budget_result
    fi
    resolve_entry "$top" >"$entry_file" || status=$?
  else
    status=$?
    printf '%s\n' "$budget_error" >&2
  fi
  entry=$(cat "$entry_file")
  rm -f -- "$entry_file" "$policy_file"
  trap - EXIT

  if [ -n "${DOTFILES_VERIFY_PUSH_BYPASS-}" ] \
    && { [ "$status" -ne 0 ] || [ -n "$entry" ]; }; then
    record_bypass "$top" "${entry:-未解決}" "$DOTFILES_VERIFY_PUSH_BYPASS"
    exit 0
  fi
  require_run_success "$status" '入口の解決'
  [ -n "$entry" ] || exit 0
  [ -n "$budget_seconds" ] || refuse "時間予算の宣言が無いため入口を実行しない: $budget_error"

  if [ "${#stale[@]}" -gt 0 ]; then
    refuse "送る ref(${stale[*]})の commit が検証する HEAD(${head:-無し})と異なる。送る commit を checkout してから push する"
  fi
  require_clean_source "$top" '検証する source が送る commit と一致しない。差分を commit するか退避し、index の印を外してから push する'

  read -r -a command <<<"$entry"
  printf 'verify-push: %s を実行する(予算 %s)\n' "$entry" "$(duration "$budget_seconds")" >&2
  # 入口の解決と検証後のsourceの確認は短い走行で、鍵を渡すと直近5件の実測を埋めて検査本体のピークを押し出すため、鍵は検査本体だけに渡す
  printf -v resource_key 'verify-push\n%s\n%s' "$top" "${command[*]}"
  run_within_budget --resource-key "$resource_key" "$top" "${command[@]}" || status=$?
  elapsed=$((SECONDS - started))

  require_run_success "$status" '検証'

  export -f require_unchanged_source commit_of require_clean_source refuse_lines refuse
  export difference_lines
  status=0
  run_within_budget "$top" "$BASH" -c "require_unchanged_source \"\$@\"" -- "$top" "$head" || status=$?
  elapsed=$((SECONDS - started))
  require_run_success "$status" '検証後のsource確定'
  printf 'verify-push: 通った(経過 %s)\n' "$(duration "$elapsed")" >&2
}

main "$@"

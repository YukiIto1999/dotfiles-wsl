+#[tokio::test]
+async fn lazy_stdio_seed_serves_the_first_session_without_starting_the_server() {
+	let script = Script::new(&["alpha", "beta"]);
+	let seed = seed(|_| vec!["alpha", "beta"], false);
+	let dormant = seeded_process(&script, &seed);
+
+	assert_eq!(handshake(&dormant, "client").await, ["alpha", "beta"]);
+	let prompts = error_of(
+		dormant
+			.send_message(request(3, json!({ "method": "prompts/list" })), &ctx())
+			.await
+			.expect("prompts/list"),
+	);
+	assert_eq!(prompts.id, Some(RequestId::Number(3)));
+	assert_eq!(prompts.error.code, rmcp::model::ErrorCode::METHOD_NOT_FOUND);
+	let ping = dormant
+		.send_message(request(4, json!({ "method": "ping" })), &ctx())
+		.await
+		.expect("ping");
+	assert_eq!(result_of(ping), json!({}));
+	// Logging the seed does not advertise is not a method of the server
+	let set = error_of(
+		dormant
+			.send_message(set_level(5, "debug"), &ctx())
+			.await
+			.expect("logging/setLevel"),
+	);
+	assert_eq!(set.id, Some(RequestId::Number(5)));
+	assert_eq!(set.error.code, rmcp::model::ErrorCode::METHOD_NOT_FOUND);
+	assert_eq!(
+		script.spawns(),
+		0,
+		"discovery, ping and log levels must not start the server"
+	);
+
+	let response = call(&dormant, 6).await;
+
+	assert_eq!(result_of(response)["content"][0]["text"], "spawn-1");
+	assert_eq!(
+		script.methods(1),
+		[
+			"initialize",
+			"notifications/initialized",
+			"tools/list",
+			"prompts/list",
+			"tools/call"
+		],
+		"the start replays every served reply and neither the ping nor the refused log level"
+	);
+}

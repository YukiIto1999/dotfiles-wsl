{
  "gateway": {
    "id": "default",
    "port": 8765,
    "service": "agentgateway-default"
  },
  "containers": [
    "crawl4ai",
    "hindsight",
    "searxng"
  ],
  "containerNetwork": "dotfiles-backends",
  "secrets": [
    "accounts/account-1/token",
    "accounts/account-1/username",
    "accounts/account-2/token",
    "accounts/account-2/username",
    "accounts/account-3/token",
    "accounts/account-3/username",
    "crawl4ai/api_token",
    "identity/default/email",
    "identity/default/name",
    "identity/work/email",
    "identity/work/name",
    "opencode/go_api_key",
    "searxng/secret_key"
  ],
  "projectMemoryPersistentMount": "hindsight-data:/home/hindsight/.pg0"
}

+#[cfg(test)]
+mod tests {
+	use crate::mcp::router::McpBackendGroup;
+	use crate::mcp::{FailureMode, McpAuthorizationSet};
+	use crate::proxy::httpproxy::PolicyClient;
+	use crate::test_helpers::proxymock::setup_proxy_test;
+
+	use super::*;
+
+	const LONG_TTL: Duration = Duration::from_secs(60);
+
+	fn relay_inputs() -> RelayInputs {
+		RelayInputs {
+			backend_id: ResourceName::new("downstream-lifecycle".into(), "tests".into()),
+			backend: McpBackendGroup {
+				targets: vec![],
+				failure_mode: FailureMode::FailOpen,
+				..Default::default()
+			},
+			policies: McpAuthorizationSet::new(crate::http::authorization::RuleSets::from(Vec::new())),
+			mcp_guardrails: None,
+			client: PolicyClient::new(setup_proxy_test("{}").expect("proxy test inputs").pi),
+		}
+	}
+
+	fn registered_session(manager: &SessionManager) -> String {
+		let inputs = relay_inputs();
+		let backend_id = inputs.backend_id.clone();
+		let relay = inputs
+			.build_new_connections(&IncomingRequestContext::empty())
+			.expect("relay with zero targets");
+		let session = manager.create_session(relay);
+		let id = session.id.to_string();
+		manager.insert_session(backend_id, session, LONG_TTL);
+		id
+	}
+
+	fn mutate_entry(manager: &SessionManager, id: &str, f: impl FnOnce(&mut SessionEntry)) {
+		let mut sessions = manager.sessions.write().expect("write lock");
+		f(sessions.get_mut(id).expect("registered session"));
+	}
+
+	fn read_entry<T>(manager: &SessionManager, id: &str, f: impl FnOnce(&SessionEntry) -> T) -> T {
+		let sessions = manager.sessions.read().expect("read lock");
+		f(sessions.get(id).expect("registered session"))
+	}
+
+	fn expire_idle_ttl(manager: &SessionManager, id: &str) {
+		mutate_entry(manager, id, |entry| entry.idle_ttl = Duration::ZERO);
+	}
+
+	fn is_registered(manager: &SessionManager, id: &str) -> bool {
+		manager.sessions.read().expect("read lock").contains_key(id)
+	}
+
+	#[tokio::test]
+	async fn downstream_lifecycle_active_get_survives_idle_ttl() {
+		let manager = SessionManager::new(http::sessionpersistence::Encoder::base64());
+		let pinned = registered_session(&manager);
+		let idle = registered_session(&manager);
+
+		expire_idle_ttl(&manager, &pinned);
+		expire_idle_ttl(&manager, &idle);
+		mutate_entry(&manager, &pinned, |entry| entry.active_streams = 1);
+
+		reap_expired_entries(&manager.sessions);
+
+		assert!(
+			is_registered(&manager, &pinned),
+			"a session with a live GET stream must survive its idle TTL"
+		);
+		assert!(
+			!is_registered(&manager, &idle),
+			"a session with no live GET stream must be reaped once its idle TTL elapses"
+		);
+	}
+
+	#[tokio::test]
+	async fn downstream_lifecycle_idle_ttl_starts_when_get_body_drops() {
+		let manager = SessionManager::new(http::sessionpersistence::Encoder::base64());
+		let id = registered_session(&manager);
+
+		let (_session, guard) = manager
+			.get_session_for_stream(&id, relay_inputs())
+			.expect("registered session");
+		let body = http::Body::empty().with_drop_guard(guard);
+		assert_eq!(
+			read_entry(&manager, &id, |entry| entry.active_streams),
+			1,
+			"an established GET stream must be counted"
+		);
+
+		let ended_at = Instant::now();
+		drop(body);
+
+		assert_eq!(
+			read_entry(&manager, &id, |entry| entry.active_streams),
+			0,
+			"dropping the response body must release the stream"
+		);
+		assert!(
+			read_entry(&manager, &id, |entry| entry.last_access) >= ended_at,
+			"the idle clock must restart from the moment the body ended, not from the last request"
+		);
+
+		reap_expired_entries(&manager.sessions);
+		assert!(
+			is_registered(&manager, &id),
+			"a session must not be reaped in the reaper tick right after its stream ended"
+		);
+
+		expire_idle_ttl(&manager, &id);
+		reap_expired_entries(&manager.sessions);
+		assert!(
+			!is_registered(&manager, &id),
+			"a session must be reaped once the idle TTL elapses after its stream ended"
+		);
+	}
+}

+/// The reply to a request the discovery its client holds no longer describes.
+fn contradicted_error(lists: &str, id: RequestId) -> ServerJsonRpcMessage {
+	ServerJsonRpcMessage::error(
+		rmcp::ErrorData::internal_error(
+			format!(
+				"stdio discovery served for {lists} no longer matches the server; it was invalidated, list it again"
+			),
+			None,
+		),
+		Some(id),
+	)
+}

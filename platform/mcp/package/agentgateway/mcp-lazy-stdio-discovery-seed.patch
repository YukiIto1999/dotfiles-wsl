+/// A seed of what the scripted server answers, with the tools each offered protocol lists.
+fn seed(tools: impl Fn(&str) -> Vec<&'static str>, logging: bool) -> Arc<DiscoverySeed> {
+	let protocols: serde_json::Map<String, Value> =
+		["2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"]
+			.into_iter()
+			.map(|protocol| {
+				let listed: Vec<Value> = tools(protocol).into_iter().map(tool).collect();
+				let entries = json!([
+					{ "method": "initialize", "params": null, "result": initialize_result(logging) },
+					{ "method": "tools/list", "params": null, "result": { "tools": listed } },
+					{ "method": "prompts/list", "params": null, "error": method_not_found() },
+					{ "method": "resources/list", "params": null, "error": method_not_found() },
+					{ "method": "resources/templates/list", "params": null, "error": method_not_found() }
+				]);
+				(protocol.to_string(), entries)
+			})
+			.collect();
+	let document = json!({ "protocols": protocols }).to_string();
+	Arc::new(DiscoverySeed::parse("/nix/store/seed.json", document.as_bytes()).expect("valid seed"))
+}

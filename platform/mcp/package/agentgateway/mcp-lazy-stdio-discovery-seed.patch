+		seed.invalidate("2025-06-18");
+		assert!(seed.reply("2025-06-18", "", true).is_none());
+		assert!(seed.reply("2025-11-25", "", true).is_some());
+		assert!(seed.reply("2099-01-01", "", true).is_some());
+
+		seed.invalidate("2099-01-01");
+		assert!(seed.reply("2099-01-01", "", true).is_none());
+		assert!(seed.reply("2026-07-28", "", true).is_none());
+		assert!(
+			seed.reply("2025-11-25", "", true).is_some(),

+
+/// What one child received for `method`, in order.
+fn received(script: &Script, spawn: usize, method: &str) -> Vec<Value> {
+	script
+		.messages
+		.lock()
+		.unwrap()
+		.iter()
+		.filter(|(index, message)| *index == spawn && message["method"] == method)
+		.map(|(_, message)| message.clone())
+		.collect()
+}
+
+fn error_of(message: ServerJsonRpcMessage) -> rmcp::model::JsonRpcError {
+	match message {
+		ServerJsonRpcMessage::Error(error) => error,
+		other => panic!("expected an error, got {other:?}"),
+	}
+}

+		let mut cursor: Option<String> = None;
+		for id in 10.. {
+			let body = match &cursor {
+				Some(cursor) => json!({ "method": "tools/list", "params": { "cursor": cursor } }),
+				None => json!({ "method": "tools/list" }),
+			};
+			let page = result_of(
+				process
+					.send_message(request(id, body), &ctx())
+					.await
+					.expect("tools/list page"),
+			);
+			cursor = page["nextCursor"].as_str().map(str::to_string);
+			pages.push(page);
+			if cursor.is_none() {
+				break;
+			}
+		}
+		pages
+	}
+
+	let script = Script::new(&["alpha", "beta"]);
+	script.paginate.store(true, Ordering::SeqCst);
+	let memo = Arc::new(TargetMemo::default());

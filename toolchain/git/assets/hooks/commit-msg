#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C.UTF-8

# $1 は <(...) 等 seek 不能な fd の場合があるため、以降は引数で受けた in-memory 行配列だけを見る
# AI client、provider、既知の attribution identity を検出する
scan_ai_attribution() {
  local -r ai_names='claude|codex|copilot|cursor|chatgpt|gemini|antigravity|opencode|google-labs|openai|ai|noreply@(anthropic|openai|google)'
  local -r ai_identity="(?<![A-Za-z0-9_])(?:$ai_names)(?![A-Za-z0-9_])"
  printf '%s\n' "$@" | grep -inP "(?i)Co-authored-by:.*${ai_identity}|(Generated|Written|Created)[-[:space:]]+(by|with).*${ai_identity}|${ai_identity}[[:space:]]*(により|によって)[[:space:]]*(生成|作成|執筆)" || true
}

# コメント行と末尾空行を除いた実効行
effective_lines() {
  local -a body=()
  local line
  for line in "$@"; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    body+=("$line")
  done

  local last=$(( ${#body[@]} - 1 ))
  while (( last >= 0 )) && [[ "${body[$last]}" =~ ^[[:space:]]*$ ]]; do
    unset "body[$last]"
    last=$(( last - 1 ))
  done

  printf '%s\n' "${body[@]}"
}

main() {
  local -r msg="$1"
  local -a raw
  mapfile -t raw < "$msg"

  local -a hits
  mapfile -t hits < <(scan_ai_attribution "${raw[@]}")
  if (( ${#hits[@]} > 0 )); then
    printf 'AI attribution: %s\n' "${hits[@]}" >&2
    echo "commit message から AI attribution を削除する" >&2
    exit 1
  fi

  local -a body
  mapfile -t body < <(effective_lines "${raw[@]}")

  if (( ${#body[@]} != 1 )) || [[ "${body[0]}" =~ ^[[:space:]]*$ ]]; then
    echo "commit message: subject 1 行だけを書く" >&2
    exit 1
  fi

  local -r subject="${body[0]}"
  if (( ${#subject} > 50 )); then
    echo "commit message: 50 文字以内にする" >&2
    exit 1
  fi

  local -r subject_pattern='^(feat|fix|refactor|docs|test|build|ci|chore|style|perf|revert): [^[:space:]].*$'
  if [[ ! "$subject" =~ $subject_pattern ]] \
    || [[ "$subject" =~ [[:space:]]$ ]]; then
    echo "commit message: scope なしの '<type>: <日本語の要約>' にする" >&2
    exit 1
  fi

  if ! printf '%s\n' "$subject" | grep -qP '[\p{Hiragana}\p{Katakana}\p{Han}]'; then
    echo "commit message: 要約を日本語で書く" >&2
    exit 1
  fi

  exit 0
}

main "$@"

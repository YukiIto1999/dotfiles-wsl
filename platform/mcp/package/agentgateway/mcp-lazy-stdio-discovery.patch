+#[tokio::test]
+async fn lazy_stdio_live_requests_do_not_take_the_start_lock() {
+	let (script, memo) = trusted_fixture().await;
+	let process = lazy_process(&script, &memo);
+	handshake(&process, "client").await;
+	call(&process, 3).await;
+
+	let start_lock = process.lazy.as_ref().expect("lazy process").state.lock().await;
+	let request = timeout(Duration::from_secs(1), call(&process, 4)).await;
+	let notification = timeout(
+		Duration::from_secs(1),
+		process.send_notification(roots_changed(), &ctx()),
+	)
+	.await;
+	drop(start_lock);
+
+	assert!(request.is_ok(), "a live request must not wait for the start lock");
+	assert!(notification.is_ok(), "a live notification must not wait for the start lock");
+}
+
+fn roots_response() -> ClientJsonRpcMessage {
+	serde_json::from_value(json!({
+		"jsonrpc": "2.0",
+		"id": "srv-roots",
+		"result": { "roots": [] }
+	}))
+	.expect("roots/list response")
+}
+
+#[tokio::test]
+async fn lazy_stdio_forwards_client_responses_while_the_start_replays() {
+	let (script, memo) = trusted_fixture().await;
+	let dormant = Arc::new(lazy_process(&script, &memo));
+	let mut events = dormant
+		.get_event_stream()
+		.await
+		.expect("event stream while dormant");
+	handshake(&dormant, "client").await;
+	script.ask_roots.store(true, Ordering::SeqCst);
+
+	let call_task = tokio::spawn({
+		let dormant = dormant.clone();
+		async move { call(&dormant, 3).await }
+	});
+
+	// After the replayed `initialized` the server asks for the client's roots and holds the
+	// replayed `tools/list` until they arrive
+	let asked = timeout(Duration::from_secs(5), events.next())
+		.await
+		.expect("the server request must reach the stream registered before the start")
+		.expect("the event stream must stay open")
+		.expect("event");
+	let asked = serde_json::to_value(&asked).expect("event");
+	assert_eq!(asked["method"], "roots/list");
+	assert_eq!(asked["id"], "srv-roots");
+	assert!(!call_task.is_finished(), "the start waits for the roots answer");
+
+	dormant
+		.send_client_message(roots_response(), &ctx())
+		.await
+		.expect("client response while the start replays");
+
+	let response = timeout(Duration::from_secs(5), call_task)
+		.await
+		.expect("the start must finish once the client answered")
+		.expect("call task");
+	assert!(matches!(response, ServerJsonRpcMessage::Response(_)));
+	let methods = script.methods(3);
+	let position = |name: &str| {
+		methods
+			.iter()
+			.position(|method| method == name)
+			.unwrap_or_else(|| panic!("{name} missing from {methods:?}"))
+	};
+	assert!(position("notifications/initialized") < position("response"));
+	assert!(position("tools/list") < position("tools/call"));
+	assert!(position("response") < position("tools/call"));
+}
+
+#[tokio::test]
+async fn lazy_stdio_dormant_session_rejects_client_responses_without_starting() {
+	let (script, memo) = trusted_fixture().await;
+	let dormant = lazy_process(&script, &memo);
+	handshake(&dormant, "client").await;
+
+	let rejected = dormant.send_client_message(roots_response(), &ctx()).await;
+
+	assert!(matches!(rejected, Err(UpstreamError::Send)));
+	assert_eq!(script.spawns(), 2);
+}

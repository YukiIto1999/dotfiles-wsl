+#[tokio::test]
+async fn lazy_stdio_cancel_of_a_call_in_flight_after_the_start_reaches_the_server() {
+	let (script, memo) = trusted_fixture().await;
+	let dormant = Arc::new(lazy_process(&script, &memo));
+	handshake(&dormant, "client").await;
+	script.call_gate.armed.store(true, Ordering::SeqCst);
+
+	let call_task = tokio::spawn({
+		let dormant = dormant.clone();
+		async move { call(&dormant, 3).await }
+	});
+	// The call is at the server, so the start is over and the call is in flight
+	script.call_gate.seen.notified().await;
+	dormant
+		.send_notification(cancelled(3), &ctx())
+		.await
+		.expect("cancel of an in-flight call");
+	script.call_gate.release.notify_one();
+
+	let response = call_task.await.expect("call task");
+
+	assert!(matches!(response, ServerJsonRpcMessage::Response(_)));
+	assert_eq!(
+		script.methods(3),
+		[
+			"initialize",
+			"notifications/initialized",
+			"tools/list",
+			"tools/call",
+			"notifications/cancelled"
+		]
+	);
+}

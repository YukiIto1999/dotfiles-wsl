+/// Whether the gateway sent the request on its own, so its reply never reaches the client.
+fn sent_by_gateway(id: &RequestId) -> bool {
+	matches!(id, RequestId::String(id) if id.starts_with(RESOLVE_ID_PREFIX))
+}

{
  "schemaVersion": 1,
  "evaluatedAt": "2026-08-13",
  "cases": [
    {
      "id": "commit-purpose",
      "prompt": "Write one commit message for a staged diff that replaces an index-mutating commit writer with a read-only commit-writing skill and updates its routing documentation.",
      "input": {
        "type": "staged-diff",
        "changes": [
          {
            "path": "skills/git-commit-writer/skill/SKILL.md",
            "before": "name: git-commit-writer",
            "after": "file removed; responsibility moves to commit-writing"
          },
          {
            "path": "skills/commit-writing/skill/SKILL.md",
            "before": "file absent",
            "after": "writes one purpose from staged diff and never changes the index"
          },
          {
            "path": "agents/policy/AGENTS.md",
            "before": "routes commit messages to git-commit-writer",
            "after": "routes commit messages to commit-writing"
          }
        ]
      },
      "expectedSkills": ["commit-writing", "ja-writing"],
      "expected": {
        "onePurpose": true,
        "recordsPurpose": true,
        "changesIndex": false,
        "readsStandardFiles": [
          "principles/documentation/commit-purpose.md",
          "principles/documentation/sentence-endings.md"
        ],
        "typePrefix": true,
        "subjectEndsWithNoun": true,
        "subjectHasTouten": false,
        "subjectHasKuten": false,
        "runsCommitMsgHookBeforeFinishing": true,
        "bypassesHook": false,
        "example": "fix: commit message作成時のindex変更の防止"
      }
    },
    {
      "id": "commit-subject-form",
      "prompt": "Write one commit message for this staged diff.",
      "input": {
        "type": "staged-diff",
        "request": "Review comment from Sato: subjects ending with verbs read as cut-off sentences in git log.",
        "changes": [
          {
            "path": "toolchain/git/assets/hooks/commit-msg",
            "before": "accepts subjects ending with a verb, adjective, or particle",
            "after": "rejects subjects ending with a verb, adjective, or particle"
          },
          {
            "path": "CONTRIBUTING.md",
            "before": "subject examples end with verbs",
            "after": "subject examples end with nouns and the hook rejection is documented"
          }
        ]
      },
      "expectedSkills": ["commit-writing", "ja-writing"],
      "expected": {
        "onePurpose": true,
        "containsPersonalName": false,
        "typePrefix": true,
        "subjectEndsWithNoun": true,
        "subjectHasTouten": false,
        "joinsTwoConcernsWithSpaceOrNakaguro": false,
        "runsCommitMsgHookBeforeFinishing": true,
        "bypassesHook": false,
        "example": "fix: 動詞や助詞で終わる件名の拒否"
      }
    },
    {
      "id": "commit-mixed-purpose",
      "prompt": "Write one commit message for this staged diff.",
      "input": {
        "type": "staged-diff",
        "changes": [
          {
            "path": "skills/comment-writing/skill/SKILL.md",
            "before": "file absent",
            "after": "adds implementation-comment decision guidance"
          },
          {
            "path": "workstation/module.nix",
            "before": "vm.swappiness = 60",
            "after": "vm.swappiness = 100"
          }
        ]
      },
      "expectedSkills": ["commit-writing", "ja-writing"],
      "expected": {
        "writesMessage": false,
        "reportsSeparatePurposes": true,
        "changesIndex": false
      }
    },
    {
      "id": "change-description",
      "prompt": "Write a PR body for an explicitly supplied staged diff. Verified facts are quick_validate.py for all local skills, git diff --check, agent-artifact-contract, agent-subagent-rendering, and docs-links, all with exit status 0.",
      "input": {
        "type": "staged-diff",
        "changes": [
          {
            "path": "skills/commit-writing/skill/SKILL.md",
            "before": "git-commit-writer may change the index",
            "after": "commit-writing reports mixed purposes without changing the index"
          },
          {
            "path": "skills/change-writing/skill/SKILL.md",
            "before": "separate PR and changelog templates",
            "after": "one change-description method with artifact-specific reference"
          },
          {
            "path": "skills/comment-writing/skill/SKILL.md",
            "before": "file absent",
            "after": "implementation comments preserve only a rejected alternative and its current constraint"
          }
        ]
      },
      "expectedSkills": ["change-writing", "ja-writing"],
      "expected": {
        "usesExplicitRangeOnly": true,
        "containsOnlyVerifiedChecks": true,
        "emptySections": false,
        "placeholderNone": false
      }
    },
    {
      "id": "declaration-and-implementation-comments",
      "prompts": {
        "documentation": "Document public processPayment(input). The amount is already validated, requests are idempotent by key, it writes the ledger, and it may return conflict. The exact conflict condition is unknown.",
        "implementation": "Decide whether to comment a retry loop that deliberately does not add exponential backoff because the upstream Retry-After value is authoritative."
      },
      "expectedSkills": {
        "documentation": ["documentation-writing"],
        "implementation": ["comment-writing"]
      },
      "expected": {
        "documentationIncludes": ["purpose summary", "input parameter", "return value", "precondition", "idempotency", "side effect", "known failure"],
        "documentationInventsConflictCondition": false,
        "documentationSummaryIsNameTranslation": false,
        "documentationSummaryOneLine": true,
        "documentationLinesEndWithNoun": true,
        "documentationLinesHavePunctuation": false,
        "documentationLinesBundleTwoConcerns": false,
        "implementationIncludes": ["rejected exponential backoff", "authoritative Retry-After constraint"],
        "implementationNarratesLoop": false,
        "implementationEndsWithNoun": true,
        "implementationHasKutenOrDesuMasu": false,
        "implementationExample": "上流の Retry-After が待機時間の正本のため指数バックオフは不採用"
      }
    },
    {
      "id": "private-declaration-documentation",
      "prompt": "Add documentation comments to this TypeScript module. Only the exported function has one today, and its summary is 注文を決済する.",
      "input": {
        "language": "typescript",
        "declarations": [
          "export function settle<T extends Order>(order: T, ledger: Ledger): Result<Receipt, SettlementError>",
          "function idempotencyKey(order: Order): string"
        ]
      },
      "expectedSkills": ["documentation-writing"],
      "expected": {
        "readsStandardFiles": [
          "principles/comment/declaration-contracts.md",
          "principles/documentation/sentence-endings.md",
          "languages/typescript/conventions.md"
        ],
        "documentsPrivateDeclarations": true,
        "coversEveryParamTypeParamAndReturn": true,
        "keepsVerbEndedSummary": false,
        "summaryIsNameTranslation": false,
        "linesEndWithNoun": true,
        "linesHavePunctuation": false,
        "decorativeMarkup": false
      }
    },
    {
      "id": "description-routing",
      "prompt": "Write a README for trace-map. It reads local trace JSON and prints service-to-service edges. The reader is an engineer deciding whether to install it. The start command is nix run .#trace-map -- sample.json. It never uploads data. Architecture details are in docs/architecture.md.",
      "expectedSkills": ["description-writing", "ja-writing"],
      "nearMiss": {
        "prompt": "Write a PR body for the change.",
        "expectedSkills": ["change-writing", "ja-writing"]
      },
      "expected": {
        "includes": ["job", "local-only data boundary", "start command", "architecture link"],
        "inventedSections": false,
        "duplicatesArchitecture": false
      }
    },
    {
      "id": "japanese-register",
      "prompt": "顧客向けincident報告を、全体を丁寧なですます調で2文にしてください。事実: 10:00にservice停止、10:07に復旧、data lossなし。",
      "expectedSkills": ["ja-writing"],
      "expected": {
        "preservesRequestedRegister": true,
        "addsUnverifiedCause": false,
        "forcesStyleVariation": false,
        "sentencesEndWithKuten": true,
        "fragmentEndings": false
      }
    },
    {
      "id": "japanese-markdown-prose",
      "prompt": "trace-mapのREADME日本語版に、英語版の次の段落と同じ内容の段落をMarkdownで書いてください。trace-map reads local trace JSON and prints service-to-service edges. It never uploads data, so traces from production can stay on the workstation.",
      "expectedSkills": ["description-writing", "ja-writing"],
      "expected": {
        "readsStandardFiles": [
          "principles/documentation/sentence-endings.md",
          "principles/naming/unified-vocabulary.md",
          "principles/documentation/minimal-high-signal.md",
          "principles/documentation/separate-document-types.md"
        ],
        "matchesEnglishCanonical": true,
        "sentencesEndWithKuten": true,
        "oneSentencePerLine": true,
        "fragmentEndings": false,
        "coinedTranslations": false,
        "emphasisOnSentencesReaderWouldNotMisread": false
      }
    },
    {
      "id": "japanese-label-boundary",
      "prompt": "この実装コメントを日本語として自然にしてください。// 上流の Retry-After が待機時間の正本のため指数バックオフは不採用",
      "expectedSkills": ["comment-writing", "ja-writing"],
      "expected": {
        "addsKuten": false,
        "rewritesIntoSentence": false,
        "endsWithNoun": true,
        "keepsRejectedAlternativeAndConstraint": true
      }
    },
    {
      "id": "comment-near-miss",
      "prompt": "Rename vague variables in code.",
      "expectedSkills": [],
      "mustNotTrigger": ["comment-writing", "documentation-writing", "ja-writing"]
    }
  ]
}

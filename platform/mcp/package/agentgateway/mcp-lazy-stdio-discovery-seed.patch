+#[tokio::test]
+async fn lazy_stdio_seed_drift_fails_the_call_before_it_reaches_the_server() {
+	let script = Script::new(&["changed"]);
+	let seed = seed(|_| vec!["alpha"], false);
+	let dormant = seeded_process(&script, &seed);
+	let mut events = dormant
+		.get_event_stream()
+		.await
+		.expect("event stream while dormant");
+	assert_eq!(handshake(&dormant, "client").await, ["alpha"]);
+
+	match call(&dormant, 3).await {
+		ServerJsonRpcMessage::Error(error) => {
+			assert_eq!(error.id, Some(RequestId::Number(3)));
+			assert!(
+				error.error.message.contains("tools/list"),
+				"{}",
+				error.error.message
+			);
+		},
+		other => panic!("a call after seed drift must fail, got {other:?}"),
+	}
+	assert!(
+		!script.methods(1).iter().any(|method| method == "tools/call"),
+		"a call behind drifted discovery must not reach the tool"
+	);
+	let announced = timeout(Duration::from_secs(1), events.next())
+		.await
+		.expect("the drift must be announced")
+		.expect("the event stream must stay open")
+		.expect("event");
+	assert_eq!(
+		serde_json::to_value(&announced).expect("event")["method"],
+		"notifications/tools/list_changed"
+	);
+	assert_eq!(list_tools(&dormant).await, ["changed"]);
+	assert_eq!(result_of(call(&dormant, 4).await)["content"][0]["text"], "spawn-1");
+
+	let same_protocol = seeded_process(&script, &seed);
+	assert_eq!(handshake(&same_protocol, "client").await, ["changed"]);
+	assert_eq!(script.spawns(), 2, "the contradicted protocol must be served live");
+	let other_protocol = seeded_process(&script, &seed);
+	other_protocol
+		.send_message(request(1, initialize_offering("client", "2025-11-25")), &ctx())
+		.await
+		.expect("initialize");
+	assert_eq!(script.spawns(), 2, "other recorded protocols stay seeded");
+}
+
+#[tokio::test]
+async fn lazy_stdio_seed_holds_the_log_level_the_served_initialize_advertised() {
+	let script = Script::new(&["alpha"]);
+	script.logging.store(true, Ordering::SeqCst);
+	let seed = seed(|_| vec!["alpha"], true);
+	let dormant = seeded_process(&script, &seed);
+	open(&dormant, "client").await;
+
+	for (id, level) in [(2, "info"), (3, "debug")] {
+		let set = dormant
+			.send_message(set_level(id, level), &ctx())
+			.await
+			.expect("logging/setLevel");
+		assert_eq!(result_of(set), json!({}));
+	}
+	assert_eq!(script.spawns(), 0, "a log level must not start the server");
+
+	let response = call(&dormant, 4).await;
+
+	assert!(matches!(response, ServerJsonRpcMessage::Response(_)));
+	assert_eq!(
+		script.methods(1),
+		[
+			"initialize",
+			"notifications/initialized",
+			"logging/setLevel",
+			"tools/call"
+		]
+	);
+	let levels = received(&script, 1, "logging/setLevel");
+	assert_eq!(levels[0]["params"]["level"], "debug", "the last level is replayed");
+}
+
+#[tokio::test]
+async fn lazy_stdio_seeded_sessions_each_start_their_own_server_once() {
+	let script = Script::new(&["alpha"]);
+	let seed = seed(|_| vec!["alpha"], false);
+	let first = seeded_process(&script, &seed);
+	let second = seeded_process(&script, &seed);
+	handshake(&first, "first").await;
+	handshake(&second, "second").await;
+
+	let (one, two) = tokio::join!(call(&first, 3), call(&first, 4));
+
+	assert_eq!(script.spawns(), 1, "concurrent first calls must start the server once");
+	assert_eq!(result_of(one)["content"][0]["text"], "spawn-1");
+	assert_eq!(result_of(two)["content"][0]["text"], "spawn-1");
+	assert_eq!(result_of(call(&second, 3).await)["content"][0]["text"], "spawn-2");
+	for (spawn, client) in [(1, "first"), (2, "second")] {
+		let initialize = received(&script, spawn, "initialize");
+		assert_eq!(
+			initialize[0]["params"]["clientInfo"]["name"], client,
+			"the start replays the client's own initialize"
+		);
+	}
+}

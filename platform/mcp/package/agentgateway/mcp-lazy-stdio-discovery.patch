+//! Discovery responses of lazily started stdio targets.
+//!
+//! A response is memoised only from live answers of the exact same executable, arguments and
+//! client `initialize` request. It is served without a child only after two identical live
+//! observations; a response observed to differ is no longer memoised. The memo lives in the
+//! gateway process, whose environment every child inherits, and never outlives it.
+
+use std::collections::HashMap;
+use std::sync::{Arc, LazyLock, Mutex};
+
+use rmcp::model::{ClientRequest, ServerResult};
+use serde_json::Value;
+use tracing::warn;
+
+/// Client `initialize` requests remembered per executable.
+const MAX_CLIENTS: usize = 16;
+/// Discovery requests remembered per client `initialize` request.
+const MAX_EXCHANGES: usize = 256;
+/// Identical live answers required before a response may be served without the child.
+const TRUSTED_OBSERVATIONS: u8 = 2;
+
+static MEMOS: LazyLock<Mutex<HashMap<String, Arc<TargetMemo>>>> = LazyLock::new(Default::default);
+
+/// The memo shared by every session of one stdio target.
+pub(crate) fn memo_for(identity: &str) -> Arc<TargetMemo> {
+	let mut memos = MEMOS.lock().expect("discovery memo registry poisoned");
+	memos.entry(identity.to_string()).or_default().clone()
+}
+
+/// Command identity within the gateway process and its inherited environment.
+pub(crate) fn identity(cmd: &str, args: &[String], clear_env: bool) -> String {
+	serde_json::json!({ "cmd": cmd, "args": args, "clearEnv": clear_env }).to_string()
+}
+
+/// Whether the response only describes the server and never the call it answers.
+pub(crate) fn is_discovery(request: &ClientRequest) -> bool {
+	matches!(
+		request.method(),
+		"initialize" | "tools/list" | "prompts/list" | "resources/list" | "resources/templates/list"
+	)
+}
+
+/// Canonical key of a discovery request without its per-request `_meta`.
+pub(crate) fn exchange_key(request: &ClientRequest) -> Option<String> {
+	if !is_discovery(request) {
+		return None;
+	}
+	let mut value = serde_json::to_value(request).ok()?;
+	let object = value.as_object_mut()?;
+	if let Some(params) = object.get_mut("params").and_then(Value::as_object_mut) {
+		params.remove("_meta");
+	}
+	let empty_params = match object.get("params") {
+		Some(Value::Null) => true,
+		Some(Value::Object(params)) => params.is_empty(),
+		_ => false,
+	};
+	if empty_params {
+		object.remove("params");
+	}
+	Some(value.to_string())
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct TargetMemo {
+	clients: Mutex<HashMap<String, ClientMemo>>,
+}
+
+#[derive(Debug, Default)]
+struct ClientMemo {
+	volatile: bool,
+	exchanges: HashMap<String, Exchange>,
+}
+
+#[derive(Debug)]
+struct Exchange {
+	result: ServerResult,
+	canonical: Value,
+	observations: u8,
+	volatile: bool,
+}
+
+impl TargetMemo {
+	/// The memoised response that may be served without the child.
+	pub(crate) fn trusted(&self, client: &str, exchange: &str) -> Option<ServerResult> {
+		let clients = self.clients.lock().ok()?;
+		let memo = clients.get(client)?;
+		if memo.volatile {
+			return None;
+		}
+		let entry = memo.exchanges.get(exchange)?;
+		(!entry.volatile && entry.observations >= TRUSTED_OBSERVATIONS).then(|| entry.result.clone())
+	}
+
+	/// Records a live response; a response that differs from an earlier one is never served.
+	pub(crate) fn observe(&self, client: &str, exchange: &str, result: &ServerResult) {
+		let Ok(canonical) = serde_json::to_value(result) else {
+			return;
+		};
+		let Ok(mut clients) = self.clients.lock() else {
+			return;
+		};
+		if !clients.contains_key(client) && clients.len() >= MAX_CLIENTS {
+			return;
+		}
+		let memo = clients.entry(client.to_string()).or_default();
+		if memo.volatile {
+			return;
+		}
+		if let Some(entry) = memo.exchanges.get_mut(exchange) {
+			if entry.volatile {
+				return;
+			}
+			if entry.canonical == canonical {
+				entry.observations = (entry.observations + 1).min(TRUSTED_OBSERVATIONS);
+			} else {
+				entry.volatile = true;
+				warn!("stdio discovery response changed between live sessions; serving it live from now on");
+			}
+			return;
+		}
+		if memo.exchanges.len() < MAX_EXCHANGES {
+			memo.exchanges.insert(
+				exchange.to_string(),
+				Exchange {
+					result: result.clone(),
+					canonical,
+					observations: 1,
+					volatile: false,
+				},
+			);
+		}
+	}
+
+	/// Stops serving every response of the client `initialize` request.
+	pub(crate) fn invalidate(&self, client: &str) {
+		if let Ok(mut clients) = self.clients.lock()
+			&& let Some(memo) = clients.get_mut(client)
+		{
+			memo.volatile = true;
+			memo.exchanges.clear();
+		}
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	fn tools(names: &[&str]) -> ServerResult {
+		let tools: Vec<Value> = names
+			.iter()
+			.map(|name| serde_json::json!({ "name": name, "inputSchema": { "type": "object" } }))
+			.collect();
+		serde_json::from_value(serde_json::json!({ "tools": tools })).expect("tools/list result")
+	}
+
+	#[test]
+	fn lazy_stdio_memo_trusts_only_two_identical_observations() {
+		let memo = TargetMemo::default();
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		assert!(memo.trusted("client", "tools/list").is_none());
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		assert!(memo.trusted("client", "tools/list").is_some());
+		assert!(memo.trusted("other", "tools/list").is_none());
+	}
+
+	#[test]
+	fn lazy_stdio_memo_never_serves_a_response_that_changed() {
+		let memo = TargetMemo::default();
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		memo.observe("client", "tools/list", &tools(&["a", "b"]));
+		memo.observe("client", "tools/list", &tools(&["a", "b"]));
+		memo.observe("client", "tools/list", &tools(&["a", "b"]));
+		assert!(memo.trusted("client", "tools/list").is_none());
+	}
+
+	#[test]
+	fn lazy_stdio_memo_invalidates_every_response_of_a_client() {
+		let memo = TargetMemo::default();
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		memo.invalidate("client");
+		assert!(memo.clients.lock().expect("memo lock")["client"].exchanges.is_empty());
+		assert!(memo.trusted("client", "tools/list").is_none());
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		memo.observe("client", "tools/list", &tools(&["a"]));
+		assert!(memo.trusted("client", "tools/list").is_none());
+	}
+
+	#[test]
+	fn lazy_stdio_invalidating_uncached_client_does_not_allocate_a_slot() {
+		let memo = TargetMemo::default();
+		let response = tools(&["a"]);
+		for index in 0..MAX_CLIENTS {
+			memo.observe(&format!("client-{index}"), "tools/list", &response);
+		}
+		memo.observe("overflow", "tools/list", &response);
+		memo.invalidate("overflow");
+		assert!(!memo.clients.lock().expect("memo lock").contains_key("overflow"));
+	}
+
+	#[test]
+	fn lazy_stdio_exchange_key_ignores_meta_and_covers_pagination() {
+		let list = |params: Value| -> ClientRequest {
+			serde_json::from_value(serde_json::json!({ "method": "tools/list", "params": params }))
+				.expect("tools/list request")
+		};
+		let first = exchange_key(&list(serde_json::json!({}))).expect("discovery key");
+		let traced = exchange_key(&list(serde_json::json!({ "_meta": { "traceparent": "00-1" } })))
+			.expect("discovery key");
+		let second = exchange_key(&list(serde_json::json!({ "cursor": "page-2" }))).expect("discovery key");
+		assert_eq!(first, traced);
+		assert_ne!(first, second);
+	}
+
+	#[test]
+	fn lazy_stdio_only_discovery_requests_have_an_exchange_key() {
+		let call: ClientRequest = serde_json::from_value(serde_json::json!({
+			"method": "tools/call",
+			"params": { "name": "state", "arguments": {} }
+		}))
+		.expect("tools/call request");
+		assert!(exchange_key(&call).is_none());
+		assert!(!is_discovery(&call));
+	}
+
+	#[test]
+	fn lazy_stdio_identity_separates_arguments_and_environment_policy() {
+		let base = identity("/bin/server", &[], false);
+		assert_ne!(base, identity("/bin/server", &["--flag".to_string()], false));
+		assert_ne!(base, identity("/bin/server", &[], true));
+		assert_ne!(base, identity("/bin/other", &[], false));
+	}
+}

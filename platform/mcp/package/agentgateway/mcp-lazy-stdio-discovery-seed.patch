+/// Where a dormant session finds the discovery it answers without its server.
+pub(crate) enum Source {
+	/// Replies observed from identical live sessions, scoped by the exact client `initialize`.
+	Memo(Arc<TargetMemo>),
+	/// Replies recorded at build time, scoped by the protocol version the client offers.
+	Seed(Arc<DiscoverySeed>),
+}
+
+impl Source {
+	/// The scope an `initialize` request opens for the discovery that follows it.
+	pub(crate) fn initialize_scope(&self, request: &ClientRequest, exchange: &str) -> Option<String> {
+		match (self, request) {
+			(Source::Memo(_), _) => Some(exchange.to_string()),
+			(Source::Seed(_), ClientRequest::InitializeRequest(initialize)) => {
+				Some(initialize.params.protocol_version.to_string())
+			},
+			(Source::Seed(_), _) => None,
+		}
+	}
+
+	/// The reply a dormant session may serve without its server.
+	pub(crate) fn reply(&self, scope: &str, exchange: &str, is_initialize: bool) -> Option<Reply> {
+		match self {
+			Source::Memo(memo) => memo.trusted(scope, exchange).map(Reply::Result),
+			Source::Seed(seed) => seed.reply(scope, exchange, is_initialize),
+		}
+	}
+
+	/// Whether live discovery is recorded to be served later.
+	pub(crate) fn observes(&self) -> bool {
+		matches!(self, Source::Memo(_))
+	}
+
+	/// Records a live discovery response.
+	pub(crate) fn observe(&self, scope: &str, exchange: &str, result: &ServerResult) {
+		if let Source::Memo(memo) = self {
+			memo.observe(scope, exchange, result);
+		}
+	}
+
+	/// Stops serving discovery a started server contradicted.
+	pub(crate) fn invalidate(&self, scope: &str) {
+		match self {
+			Source::Memo(memo) => memo.invalidate(scope),
+			Source::Seed(seed) => seed.invalidate(scope),
+		}
+	}
+}
+
+/// A discovery reply: the result or the JSON-RPC error the server answers with.
+#[derive(Debug, Clone)]
+pub(crate) enum Reply {
+	Result(ServerResult),
+	Error(ErrorData),
+}
+
+impl Reply {
+	/// The reply in the normalised form a live reply is compared with.
+	pub(crate) fn canonical(&self) -> Option<Value> {
+		match self {
+			Reply::Result(result) => canonical_result(result),
+			Reply::Error(error) => canonical_error(error),
+		}
+	}
+
+	/// The normalised form of a live reply; `None` for a message that answers no request.
+	pub(crate) fn canonical_of(message: &ServerJsonRpcMessage) -> Option<Value> {
+		match message {
+			ServerJsonRpcMessage::Response(response) => canonical_result(&response.result),
+			ServerJsonRpcMessage::Error(error) => canonical_error(&error.error),
+			_ => None,
+		}
+	}
+
+	pub(crate) fn into_message(self, id: RequestId) -> ServerJsonRpcMessage {
+		match self {
+			Reply::Result(result) => ServerJsonRpcMessage::response(result, id),
+			Reply::Error(error) => ServerJsonRpcMessage::error(error, Some(id)),
+		}
+	}
+}
+
+fn canonical_result(result: &ServerResult) -> Option<Value> {
+	Some(serde_json::json!({ "result": serde_json::to_value(result).ok()? }))
+}
+
+fn canonical_error(error: &ErrorData) -> Option<Value> {
+	Some(serde_json::json!({ "error": serde_json::to_value(error).ok()? }))
+}
+
+/// Protocol versions a seed records, keyed by the version the client offers.
+const SEED_PROTOCOLS: [&str; 4] = ["2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"];
+/// The recorded protocol served to a client offering a version the seed does not record; the
+/// client checks the version the server negotiated.
+const SEED_LATEST_PROTOCOL: &str = "2025-11-25";
+/// List methods a seed records for every protocol, single page and without parameters.
+const SEED_LISTS: [&str; 4] = [
+	"tools/list",
+	"prompts/list",
+	"resources/list",
+	"resources/templates/list",
+];
+
+/// Discovery a server answered at build time, served before a session's server starts.
+pub struct DiscoverySeed {
+	path: String,
+	protocols: HashMap<String, SeedProtocol>,
+	/// Set once a client offering an unrecorded version saw a started server contradict the
+	/// latest recorded protocol; such clients are then served live.
+	unrecorded_invalidated: AtomicBool,
+}
+
+struct SeedProtocol {
+	initialize: ServerResult,
+	/// Replies keyed by the exchange key of the request they answer.
+	lists: HashMap<String, Reply>,
+	/// Set once a started server contradicted the protocol; it is then served live.
+	invalidated: AtomicBool,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SeedFile {
+	protocols: HashMap<String, Vec<SeedEntry>>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SeedEntry {
+	method: String,
+	#[serde(default)]
+	params: Option<Value>,
+	#[serde(default)]
+	result: Option<Value>,
+	#[serde(default)]
+	error: Option<SeedError>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SeedError {
+	code: i32,
+	message: String,
+	#[serde(default)]
+	data: Option<Value>,
+}
+
+impl DiscoverySeed {
+	/// Validates a seed file; `path` only names the seed in diagnostics.
+	pub fn parse(path: &str, bytes: &[u8]) -> anyhow::Result<Self> {
+		let file: SeedFile = serde_json::from_slice(bytes).context("invalid discovery seed")?;
+		let mut protocols = HashMap::new();
+		for (version, entries) in file.protocols {
+			if !SEED_PROTOCOLS.contains(&version.as_str()) {
+				bail!("protocol {version} is not a recorded MCP protocol version");
+			}
+			let protocol = SeedProtocol::parse(entries).with_context(|| format!("protocol {version}"))?;
+			protocols.insert(version, protocol);
+		}
+		if let Some(missing) = SEED_PROTOCOLS
+			.iter()
+			.find(|version| !protocols.contains_key(**version))
+		{
+			bail!("protocol {missing} is missing");
+		}
+		Ok(Self {
+			path: path.to_string(),
+			protocols,
+			unrecorded_invalidated: AtomicBool::new(false),
+		})
+	}
+
+	fn recorded(&self, offered: &str) -> Option<(&SeedProtocol, bool)> {
+		match self.protocols.get(offered) {
+			Some(protocol) => Some((protocol, true)),
+			None => Some((self.protocols.get(SEED_LATEST_PROTOCOL)?, false)),
+		}
+	}
+
+	fn reply(&self, offered: &str, exchange: &str, is_initialize: bool) -> Option<Reply> {
+		let (protocol, recorded) = self.recorded(offered)?;
+		if protocol.invalidated.load(Ordering::Acquire)
+			|| (!recorded && self.unrecorded_invalidated.load(Ordering::Acquire))
+		{
+			return None;
+		}
+		if is_initialize {
+			return Some(Reply::Result(protocol.initialize.clone()));
+		}
+		protocol.lists.get(exchange).cloned()
+	}
+
+	fn invalidate(&self, offered: &str) {
+		let Some((protocol, recorded)) = self.recorded(offered) else {
+			return;
+		};
+		let flag = if recorded {
+			&protocol.invalidated
+		} else {
+			&self.unrecorded_invalidated
+		};
+		if !flag.swap(true, Ordering::AcqRel) {
+			warn!(
+				seed = %self.path,
+				protocol = offered,
+				"stdio discovery seed contradicted by the started server; serving this protocol live from now on"
+			);
+		}
+	}
+}
+
+impl SeedProtocol {
+	fn parse(entries: Vec<SeedEntry>) -> anyhow::Result<Self> {
+		let mut initialize = None;
+		let mut lists = HashMap::new();
+		for SeedEntry {
+			method,
+			params,
+			result,
+			error,
+		} in entries
+		{
+			if params.is_some() {
+				bail!("{method}: params must be null or absent");
+			}
+			let reply = match (result, error) {
+				(Some(result), None) => {
+					if result.get("nextCursor").is_some() {
+						bail!("{method}: a paginated result cannot be seeded");
+					}
+					let result: ServerResult = serde_json::from_value(result)
+						.with_context(|| format!("{method}: invalid result"))?;
+					if !answers(&method, &result) {
+						bail!("{method}: the result does not answer {method}");
+					}
+					Reply::Result(result)
+				},
+				(None, Some(SeedError { code, message, data })) => {
+					Reply::Error(ErrorData::new(ErrorCode(code), message, data))
+				},
+				_ => bail!("{method}: exactly one of result and error is required"),
+			};
+			if method == "initialize" {
+				let Reply::Result(result) = reply else {
+					bail!("initialize must be answered with a result");
+				};
+				if initialize.replace(result).is_some() {
+					bail!("initialize is recorded twice");
+				}
+				continue;
+			}
+			if !SEED_LISTS.contains(&method.as_str()) {
+				bail!("{method} cannot be seeded");
+			}
+			if lists.insert(list_key(&method)?, reply).is_some() {
+				bail!("{method} is recorded twice");
+			}
+		}
+		let Some(initialize) = initialize else {
+			bail!("initialize is missing");
+		};
+		let ServerResult::InitializeResult(initialized) = &initialize else {
+			bail!("initialize: the result does not answer initialize");
+		};
+		for method in SEED_LISTS {
+			match lists.get(&list_key(method)?) {
+				None => bail!("{method} is missing"),
+				Some(Reply::Error(_)) if advertises(initialized, method) => {
+					bail!("{method} failed although the server advertises it")
+				},
+				Some(_) => {},
+			}
+		}
+		Ok(Self {
+			initialize,
+			lists,
+			invalidated: AtomicBool::new(false),
+		})
+	}
+}
+
+impl fmt::Debug for DiscoverySeed {
+	fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+		f.debug_struct("DiscoverySeed")
+			.field("path", &self.path)
+			.finish_non_exhaustive()
+	}
+}
+
+/// A seed is configured by its path.
+impl serde::Serialize for DiscoverySeed {
+	fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+		self.path.serialize(serializer)
+	}
+}
+
+/// Whether `result` is what a server answers to `method`.
+fn answers(method: &str, result: &ServerResult) -> bool {
+	matches!(
+		(method, result),
+		("initialize", ServerResult::InitializeResult(_))
+			| ("tools/list", ServerResult::ListToolsResult(_))
+			| ("prompts/list", ServerResult::ListPromptsResult(_))
+			| ("resources/list", ServerResult::ListResourcesResult(_))
+			| ("resources/templates/list", ServerResult::ListResourceTemplatesResult(_))
+	)
+}
+
+/// Whether the server's capabilities promise an answer to the list `method`.
+fn advertises(initialized: &InitializeResult, method: &str) -> bool {
+	let capabilities = &initialized.capabilities;
+	match method {
+		"tools/list" => capabilities.tools.is_some(),
+		"prompts/list" => capabilities.prompts.is_some(),
+		"resources/list" | "resources/templates/list" => capabilities.resources.is_some(),
+		_ => false,
+	}
+}
+
+/// The exchange key of a list request without parameters.
+fn list_key(method: &str) -> anyhow::Result<String> {
+	let request: ClientRequest = serde_json::from_value(serde_json::json!({ "method": method }))
+		.with_context(|| format!("{method} is not a client request"))?;
+	exchange_key(&request).ok_or_else(|| anyhow!("{method} is not discovery"))
+}

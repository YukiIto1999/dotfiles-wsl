+
+	fn set_tools(&self, tools: &[&str]) {
+		*self.tools.lock().unwrap() = tools.iter().map(|tool| tool.to_string()).collect();
+	}
+
+	/// Methods one child received, in order.
+	fn methods(&self, spawn: usize) -> Vec<String> {
+		self
+			.messages
+			.lock()
+			.unwrap()
+			.iter()
+			.filter(|(index, _)| *index == spawn)
+			.map(|(_, message)| message["method"].as_str().unwrap_or("response").to_string())
+			.collect()
+	}
+}
+
+/// Holds the reply to one method until the test releases it, and tells the test when it arrived.
+#[derive(Clone, Default)]
+struct Gate {
+	armed: Arc<AtomicBool>,
+	seen: Arc<Notify>,
+	release: Arc<Notify>,
+}
+
+/// What a started child does. It runs beside the process task like a real server, so holding one
+/// reply never blocks the client messages queued behind it.
+struct ScriptedServer {
+	script: Script,
+	index: usize,
+	tools: Vec<String>,
+}
+
+struct Scripted {
+	script: Script,
+	index: usize,
+	inbox: mpsc::UnboundedSender<ClientJsonRpcMessage>,
+	rx: mpsc::Receiver<ServerJsonRpcMessage>,
+}
+
+fn tool(name: &str) -> Value {
+	json!({ "name": name, "inputSchema": { "type": "object" } })
+}
+
+fn roots_request() -> ServerJsonRpcMessage {
+	serde_json::from_value(json!({ "jsonrpc": "2.0", "id": "srv-roots", "method": "roots/list" }))
+		.expect("roots/list request")
+}
+
+impl Scripted {
+	fn new(script: &Script) -> Self {
+		let index = script.spawns.fetch_add(1, Ordering::SeqCst) + 1;
+		let (tx, rx) = mpsc::channel(16);
+		let (inbox, mut inbox_rx) = mpsc::unbounded_channel();
+		let server = ScriptedServer {
+			script: script.clone(),
+			index,
+			tools: script.tools.lock().unwrap().clone(),
+		};
+		tokio::spawn(async move {
+			while let Some(item) = inbox_rx.recv().await {
+				server.handle(item, &tx).await;
+			}
+		});
+		Self {
+			script: script.clone(),
+			index,
+			inbox,
+			rx,
+		}
+	}
+}
+
+impl ScriptedServer {
+	fn tools_page(&self, request: &ClientRequest) -> Value {
+		let cursor = serde_json::to_value(request)
+			.ok()
+			.and_then(|value| value["params"]["cursor"].as_str().map(str::to_string));
+		if self.script.paginate.load(Ordering::SeqCst) && self.tools.len() > 1 {
+			return match cursor {
+				None => json!({ "tools": [tool(&self.tools[0])], "nextCursor": "page-2" }),
+				Some(_) => json!({ "tools": self.tools[1..].iter().map(|name| tool(name)).collect::<Vec<_>>() }),
+			};
+		}
+		json!({ "tools": self.tools.iter().map(|name| tool(name)).collect::<Vec<_>>() })
+	}
+
+	fn gate_for(&self, req: &JsonRpcRequest<ClientRequest>) -> Option<Gate> {
+		let gate = match req.request.method() {
+			"initialize" => &self.script.initialize_gate,
+			"tools/call" => &self.script.call_gate,
+			_ => return None,
+		};
+		gate.armed.load(Ordering::SeqCst).then(|| gate.clone())
+	}
+
+	fn replies(&self, req: &JsonRpcRequest<ClientRequest>) -> Vec<ServerJsonRpcMessage> {
+		let id = serde_json::to_value(&req.id).expect("request id");
+		let reply = |result: Value| -> ServerJsonRpcMessage {
+			serde_json::from_value(json!({ "jsonrpc": "2.0", "id": id, "result": result }))
+				.expect("server response")
+		};
+		match req.request.method() {
+			"initialize" if self.script.silent_initialize.load(Ordering::SeqCst) => Vec::new(),
+			"initialize" if self.script.reject_initialize.load(Ordering::SeqCst) => {
+				vec![
+					serde_json::from_value(json!({
+						"jsonrpc": "2.0",
+						"id": id,
+						"error": { "code": -32600, "message": "initialize rejected" }
+					}))
+					.expect("error response"),
+				]
+			},
+			"initialize" => vec![reply(json!({
+				"protocolVersion": "2025-06-18",
+				"capabilities": { "tools": {} },
+				"serverInfo": { "name": "scripted", "version": "1" }
+			}))],
+			"tools/list" => vec![reply(self.tools_page(&req.request))],
+			"tools/call" => {
+				let mut replies = Vec::new();
+				if self.script.progress_on_call.load(Ordering::SeqCst) {
+					replies.push(
+						serde_json::from_value(json!({
+							"jsonrpc": "2.0",
+							"method": "notifications/progress",
+							"params": { "progressToken": "call", "progress": 1 }
+						}))
+						.expect("progress notification"),
+					);
+				}
+				replies.push(reply(json!({
+					"content": [{ "type": "text", "text": format!("spawn-{}", self.index) }],
+					"isError": false
+				})));
+				replies
+			},
+			_ => vec![reply(json!({}))],
+		}
+	}
+
+	async fn handle(&self, item: ClientJsonRpcMessage, tx: &mpsc::Sender<ServerJsonRpcMessage>) {
+		// After `initialized` a server may ask the client for its roots
+		if self.script.ask_roots.load(Ordering::SeqCst)
+			&& matches!(&item, JsonRpcMessage::Notification(_))
+			&& serde_json::to_value(&item)
+				.is_ok_and(|value| value["method"] == "notifications/initialized")
+		{
+			let _ = tx.send(roots_request()).await;
+		}
+		let JsonRpcMessage::Request(req) = &item else {
+			return;
+		};
+		let gate = self.gate_for(req);
+		if let Some(gate) = &gate {
+			gate.seen.notify_one();
+		}
+		if self.script.ask_roots.load(Ordering::SeqCst) && req.request.method() == "tools/list" {
+			self.script.roots_answered.notified().await;
+		}
+		if let Some(gate) = gate {
+			gate.release.notified().await;
+		}
+		for reply in self.replies(req) {
+			let _ = tx.send(reply).await;
+		}
+	}
+}
+
+impl MCPTransport for Scripted {
+	fn send(
+		&mut self,
+		item: ClientJsonRpcMessage,
+		_: &IncomingRequestContext,
+	) -> impl Future<Output = Result<(), UpstreamError>> + Send + 'static {
+		self
+			.script
+			.messages
+			.lock()
+			.unwrap()
+			.push((self.index, serde_json::to_value(&item).expect("client message")));
+		if let JsonRpcMessage::Response(response) = &item
+			&& response.id == RequestId::String("srv-roots".into())
+		{
+			self.script.roots_answered.notify_one();
+		}
+		let _ = self.inbox.send(item);
+		std::future::ready(Ok(()))
+	}
+
+	fn receive(&mut self) -> impl Future<Output = Option<ServerJsonRpcMessage>> + Send {
+		self.rx.recv()
+	}
+
+	fn close(&mut self) -> impl Future<Output = Result<(), UpstreamError>> + Send {
+		std::future::ready(Ok(()))
+	}
+}
+
+fn lazy_process(script: &Script, memo: &Arc<TargetMemo>) -> Process {
+	let script = script.clone();
+	Process::new_lazy(move || Ok(Scripted::new(&script)), memo.clone())
+}
+
+fn ctx() -> IncomingRequestContext {
+	IncomingRequestContext::empty()
+}
+
+fn request(id: i64, body: Value) -> JsonRpcRequest<ClientRequest> {
+	JsonRpcRequest::new(
+		RequestId::Number(id),
+		serde_json::from_value(body).expect("client request"),
+	)
+}
+
+fn initialize(client: &str) -> Value {
+	json!({
+		"method": "initialize",
+		"params": {
+			"protocolVersion": "2025-06-18",
+			"capabilities": { "roots": {} },
+			"clientInfo": { "name": client, "version": "1" }
+		}
+	})
+}
+
+fn initialized() -> ClientNotification {
+	ClientNotification::InitializedNotification(InitializedNotification {
+		method: Default::default(),
+		extensions: Default::default(),
+	})
+}
+
+fn roots_changed() -> ClientNotification {
+	ClientNotification::RootsListChangedNotification(RootsListChangedNotification {
+		method: Default::default(),
+		extensions: Default::default(),
+	})
+}
+
+fn result_of(message: ServerJsonRpcMessage) -> Value {
+	match message {
+		ServerJsonRpcMessage::Response(response) => {
+			serde_json::to_value(response.result).expect("response result")
+		},
+		other => panic!("expected a response, got {other:?}"),
+	}
+}
+
+fn tool_names(result: &Value) -> Vec<String> {
+	result["tools"]
+		.as_array()
+		.expect("tools")
+		.iter()
+		.map(|tool| tool["name"].as_str().expect("tool name").to_string())
+		.collect()
+}
+
+/// The client's `initialize` request followed by its `initialized` notification.
+async fn open(process: &Process, client: &str) {
+	process
+		.send_message(request(1, initialize(client)), &ctx())
+		.await
+		.expect("initialize");
+	process
+		.send_notification(initialized(), &ctx())
+		.await
+		.expect("initialized");
+}
+
+async fn list_tools(process: &Process) -> Vec<String> {
+	let list = process
+		.send_message(request(2, json!({ "method": "tools/list" })), &ctx())
+		.await
+		.expect("tools/list");
+	tool_names(&result_of(list))
+}
+
+async fn handshake(process: &Process, client: &str) -> Vec<String> {
+	open(process, client).await;
+	list_tools(process).await
+}
+
+async fn call(process: &Process, id: i64) -> ServerJsonRpcMessage {
+	process
+		.send_message(
+			request(
+				id,
+				json!({ "method": "tools/call", "params": { "name": "state", "arguments": {} } }),
+			),
+			&ctx(),
+		)
+		.await
+		.expect("tools/call")
+}

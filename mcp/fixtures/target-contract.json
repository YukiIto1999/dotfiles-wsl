{
  "enabledProviders": [
    "chrome-devtools",
    "codex",
    "context7",
    "crawl4ai",
    "github",
    "memory",
    "playwright",
    "searxng",
    "sonarqube"
  ],
  "targets": {
    "chrome-devtools": {
      "needsNetwork": true,
      "port": 8779,
      "probe": {
        "args": {},
        "timeout": 30,
        "tool": "list_pages"
      },
      "provider": "chrome-devtools",
      "waitUnits": []
    },
    "codex": {
      "needsNetwork": true,
      "port": 8777,
      "probe": {
        "args": {
          "approval-policy": "never",
          "cwd": "/tmp",
          "prompt": "Reply with exactly OK.",
          "sandbox": "read-only"
        },
        "timeout": 120,
        "tool": "codex"
      },
      "provider": "codex",
      "waitUnits": []
    },
    "context7": {
      "needsNetwork": true,
      "port": 8771,
      "probe": {
        "args": {
          "libraryName": "nixpkgs",
          "query": "Nix option types"
        },
        "timeout": 30,
        "tool": "resolve-library-id"
      },
      "provider": "context7",
      "waitUnits": []
    },
    "crawl4ai": {
      "needsNetwork": false,
      "port": 8773,
      "probe": {
        "args": {
          "context_type": "doc",
          "max_results": 1,
          "query": "health"
        },
        "timeout": 60,
        "tool": "ask"
      },
      "provider": "crawl4ai",
      "waitUnits": [
        "docker-crawl4ai.service"
      ]
    },
    "github-account-1": {
      "needsNetwork": true,
      "port": 8780,
      "probe": {
        "args": {},
        "timeout": 30,
        "tool": "get_me"
      },
      "provider": "github",
      "waitUnits": []
    },
    "github-account-2": {
      "needsNetwork": true,
      "port": 8781,
      "probe": {
        "args": {},
        "timeout": 30,
        "tool": "get_me"
      },
      "provider": "github",
      "waitUnits": []
    },
    "github-account-3": {
      "needsNetwork": true,
      "port": 8782,
      "probe": {
        "args": {},
        "timeout": 30,
        "tool": "get_me"
      },
      "provider": "github",
      "waitUnits": []
    },
    "memory": {
      "needsNetwork": false,
      "port": 8774,
      "probe": {
        "args": {
          "format": "compact",
          "limit": 1,
          "query": "dotfiles-doctor-probe-no-match"
        },
        "timeout": 30,
        "tool": "memory_recall"
      },
      "provider": "memory",
      "waitUnits": [
        "docker-agentmemory.service"
      ]
    },
    "playwright": {
      "needsNetwork": true,
      "port": 8776,
      "probe": {
        "args": {
          "action": "list"
        },
        "timeout": 30,
        "tool": "browser_tabs"
      },
      "provider": "playwright",
      "waitUnits": []
    },
    "searxng": {
      "needsNetwork": false,
      "port": 8775,
      "probe": {
        "args": {
          "num_results": 1,
          "query": "dotfiles doctor probe"
        },
        "timeout": 30,
        "tool": "searxng_web_search"
      },
      "provider": "searxng",
      "waitUnits": [
        "docker-searxng.service"
      ]
    },
    "sonarqube": {
      "needsNetwork": false,
      "port": 8778,
      "probe": {
        "args": {},
        "timeout": 30,
        "tool": "system_status"
      },
      "provider": "sonarqube",
      "waitUnits": [
        "docker-sonarqube.service",
        "docker-sonarqube-db.service"
      ]
    }
  }
}

#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C.UTF-8

# $1 は <(...) 等 seek 不能な fd の場合があるため、以降は引数で受けた in-memory 行配列だけを見る
# AI client、provider、既知の attribution identity を検出する
scan_ai_attribution() {
  local -r ai_names='claude|codex|copilot|cursor|chatgpt|gemini|antigravity|opencode|google-labs|openai|ai|noreply@(anthropic|openai|google)'
  local -r ai_identity="(?<![A-Za-z0-9_])(?:$ai_names)(?![A-Za-z0-9_])"
  printf '%s\n' "$@" | grep -inP "(?i)Co-authored-by:.*${ai_identity}|(Generated|Written|Created)[-[:space:]]+(by|with).*${ai_identity}|${ai_identity}[[:space:]]*(により|によって)[[:space:]]*(生成|作成|執筆)" || true
}

# コメント行と末尾空行を除いた実効行
effective_lines() {
  local -a body=()
  local line
  for line in "$@"; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    body+=("$line")
  done

  local last=$(( ${#body[@]} - 1 ))
  while (( last >= 0 )) && [[ "${body[$last]}" =~ ^[[:space:]]*$ ]]; do
    unset "body[$last]"
    last=$(( last - 1 ))
  done

  printf '%s\n' "${body[@]}"
}

# 違反した規則と理由の提示による commit の拒否
#   $1: 違反した規則
#   $2 以降: 理由と直し方の各行
#   終了: status 1 での hook の終了
reject() {
  printf 'commit message: %s\n' "$1" >&2
  shift
  if (( $# > 0 )); then
    printf '  %s\n' "$@" >&2
  fi
  exit 1
}

main() {
  local -r msg="$1"
  local -a raw
  mapfile -t raw < "$msg"

  local -a hits
  mapfile -t hits < <(scan_ai_attribution "${raw[@]}")
  if (( ${#hits[@]} > 0 )); then
    printf 'AI attribution: %s\n' "${hits[@]}" >&2
    reject "AI attribution を削除する。"
  fi

  local -a body
  mapfile -t body < <(effective_lines "${raw[@]}")

  if (( ${#body[@]} != 1 )) || [[ "${body[0]}" =~ ^[[:space:]]*$ ]]; then
    reject "subject 1 行だけを書く。"
  fi

  local -r subject="${body[0]}"
  if (( ${#subject} > 50 )); then
    reject "50 文字以内にする。"
  fi

  local -r subject_pattern='^(feat|fix|refactor|docs|test|build|ci|chore|style|perf|revert): [^[:space:]].*$'
  if [[ ! "$subject" =~ $subject_pattern ]] \
    || [[ "$subject" =~ [[:space:]]$ ]]; then
    reject "scope なしの '<type>: <日本語の要約>' にする。"
  fi

  if ! printf '%s\n' "$subject" | grep -qP '[\p{Hiragana}\p{Katakana}\p{Han}]'; then
    reject "要約を日本語で書く。"
  fi

  local -r summary="${subject#*: }"
  local -r closing_hint='「…の追加」「…の見直し」のように名詞で終える。'

  if [[ "$summary" == *、* ]]; then
    reject "要約に読点「、」を使わない。" \
      "件名は句点を付けない一行の見出しであり、読点はその一行に二つの関心が入っている印になる。" \
      "関心が二つなら commit を分け、語を簡潔に並べるだけなら中黒「・」を使う。"
  fi

  if [[ "$summary" == *。* ]]; then
    reject "要約に句点「。」を付けない。" \
      "件名は文ではなく、一覧で読む見出しである。"
  fi

  # 括弧書きごとの末尾判定は括弧の手前の動詞終わりを見逃すため不採用
  local -r trailing_note='^(.*[^[:space:]])[[:space:]]*[（(][^（）()]*[）)]$'
  local closing="$summary"
  if [[ "$closing" =~ $trailing_note ]]; then
    closing="${BASH_REMATCH[1]}"
  fi

  # 「い」全体の拒否は「扱い」「違い」のような名詞の末尾も拒むため不採用
  local -r predicate_ending='.{0,4}(ない|無い|しい|たい|[るすくぐむぶぬつうただ])$'
  if [[ "$closing" =~ $predicate_ending ]]; then
    reject "要約を動詞や形容詞で終えない。末尾が「…${BASH_REMATCH[0]}」になっている。" \
      "件名は句点を付けない見出しである。" \
      "名詞で終えると、時制も主語も意図の表明も持たないラベルとして閉じ、一覧で揃って読める。" \
      "動詞や形容詞で終えると文になり、句点がないため途中で切れた文に読める。" \
      "「…する」「…した」は、見出しに要らない予定や報告も持ち込む。" \
      "$closing_hint"
  fi

  # 「と」「て」「の」は「こと」「割り当て」「もの」のような名詞の末尾にもなるため対象外
  local -r particle_ending='.{0,4}[へをにでがは]$'
  if [[ "$closing" =~ $particle_ending ]]; then
    reject "要約を助詞で終えない。末尾が「…${BASH_REMATCH[0]}」になっている。" \
      "助詞で終えると後ろの動詞を省いた文の切れ端になり、見出しとして閉じない。" \
      "$closing_hint"
  fi

  exit 0
}

main "$@"

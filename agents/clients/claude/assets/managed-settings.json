{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_NO_MODEL_FALLBACK": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "@telemetryProtocol@",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "@telemetryEndpoint@"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "@lspMarketplacePath@"
      }
    }
  },
  "enabledPlugins": {
    "lsp@dotfiles": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-memory hook --harness claude session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-memory hook --harness claude prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-agent-gate hook edit"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-agent-gate hook learn"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-agent-gate hook arm"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-memory hook --harness claude pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-memory hook --harness claude stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-agent-gate hook stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/dotfiles-memory hook --harness claude session-end"
          }
        ]
      }
    ]
  }
}

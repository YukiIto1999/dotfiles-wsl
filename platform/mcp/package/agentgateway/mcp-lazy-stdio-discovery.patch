+/// State of a process whose server starts on the first request that needs it.
+struct Lazy {
+	memo: Arc<TargetMemo>,
+	/// The client `initialize` request this session negotiated, scoping the memoised discovery.
+	client_key: Mutex<Option<String>>,
+	/// Set once the transport runs, including while the start replays; client responses to server
+	/// requests are forwarded from then on.
+	started: AtomicBool,
+	/// Set once the server is ready for requests, so they skip the start lock; only the start path
+	/// clears or sets it.
+	live: AtomicBool,
+	/// Held while the server starts and while a request that started it is handed over, so concurrent
+	/// first requests start it once and nothing sent afterwards overtakes them.
+	state: tokio::sync::Mutex<LazyState>,
+}

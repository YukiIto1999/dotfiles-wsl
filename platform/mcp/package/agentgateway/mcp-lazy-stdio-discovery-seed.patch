+		.await
+		.expect("the drift must be announced")
+		.expect("the event stream must stay open")
+		.expect("event");
+	assert_eq!(
+		serde_json::to_value(&announced).expect("event")["method"],
+		"notifications/tools/list_changed"
+	);
+	// A list the gateway sends on its own to resolve a name never reaches the client
+	let resolve = JsonRpcRequest::new(
+		RequestId::String(format!("{RESOLVE_ID_PREFIX}0").into()),
+		serde_json::from_value(json!({ "method": "tools/list" })).expect("tools/list"),
+	);
+	session
+		.send_message(resolve, &ctx())
+		.await
+		.expect("resolve list");
+
+	// Before the client lists the tools again only a tool it was served as the server defines it
+	// is called: a changed schema, a removed and an added tool are refused like the first call
+	for (id, name) in [(4, "beta"), (5, "gamma"), (6, "delta")] {
+		let refused = error_of(call_tool(&session, id, name).await);
+		assert_eq!(refused.id, Some(RequestId::Number(id)));
+		assert_eq!(refused.error.code, first.error.code, "{name}");

+/// A list whose entries are what other requests name.
+#[derive(Debug)]
+struct Listed {
+	method: &'static str,
+	/// The result field holding the entries.
+	entries: &'static str,
+	/// The entry field a request names an entry by.
+	key: &'static str,
+	/// Whether a key is a URI template, naming every URI it could expand to.
+	template: bool,
+}
+
+static LISTED: [Listed; 4] = [
+	Listed {
+		method: "tools/list",
+		entries: "tools",
+		key: "name",
+		template: false,
+	},
+	Listed {
+		method: "prompts/list",
+		entries: "prompts",
+		key: "name",
+		template: false,
+	},
+	Listed {
+		method: "resources/list",
+		entries: "resources",
+		key: "uri",
+		template: false,
+	},
+	Listed {
+		method: "resources/templates/list",
+		entries: "resourceTemplates",
+		key: "uriTemplate",
+		template: true,
+	},
+];
+
+/// Lists that name the target of a resource request.
+const RESOURCE_LISTS: [&str; 2] = ["resources/list", "resources/templates/list"];
+
+impl Listed {
+	/// The entries of a canonical reply by their key; an error reply has none.
+	fn entries<'a>(&self, reply: &'a Value) -> impl Iterator<Item = (&'a str, &'a Value)> + use<'a> {
+		let key = self.key;
+		reply["result"][self.entries]
+			.as_array()
+			.into_iter()
+			.flatten()
+			.filter_map(move |entry| Some((entry[key].as_str()?, entry)))
+	}
+}
+
+/// Listed entries whose definition in the discovery a session was served differs from what its
+/// started server lists, including entries only one of them lists: tools and prompts by name,
+/// resources by URI, resource templates by URI template. A request naming one is refused until
+/// the session's client lists it again, so no call reaches the server under a definition the
+/// client was not given; any other request may reach the server.
+#[derive(Debug, Default)]
+pub(crate) struct Contradicted {
+	lists: Vec<ContradictedList>,
+}
+
+#[derive(Debug)]
+struct ContradictedList {
+	listed: &'static Listed,
+	keys: HashSet<String>,
+	/// Set once the client asked for the first page again, so its last page leaves nothing of the
+	/// list contradicted.
+	relisting: bool,
+}
+
+impl Contradicted {
+	/// Compares each list reply a session was served with the started server's reply to the same
+	/// request; `live` holds those replies in the order of `served`.
+	pub(crate) fn between(served: &[(ClientRequest, Value)], live: &[Option<Value>]) -> Self {
+		let lists = LISTED
+			.iter()
+			.filter_map(|listed| {
+				let mut served_entries: HashMap<&str, Vec<&Value>> = HashMap::new();
+				let mut live_entries: HashMap<&str, Vec<&Value>> = HashMap::new();
+				for ((request, served), live) in served.iter().zip(live) {
+					if request.method() != listed.method {
+						continue;
+					}
+					for (key, entry) in listed.entries(served) {
+						served_entries.entry(key).or_default().push(entry);
+					}
+					for (key, entry) in live.iter().flat_map(|live| listed.entries(live)) {
+						live_entries.entry(key).or_default().push(entry);
+					}
+				}
+				let keys: HashSet<String> = served_entries
+					.keys()
+					.chain(live_entries.keys())
+					.filter(|key| served_entries.get(**key) != live_entries.get(**key))
+					.map(|key| key.to_string())
+					.collect();
+				(!keys.is_empty()).then_some(ContradictedList {
+					listed,
+					keys,
+					relisting: false,
+				})
+			})
+			.collect();
+		Self { lists }
+	}
+
+	pub(crate) fn is_empty(&self) -> bool {
+		self.lists.is_empty()
+	}
+
+	/// The list whose contradicted entry `request` names, if any. A resource URI is also named by
+	/// a contradicted template that could expand to it.
+	pub(crate) fn refusal(&self, request: &ClientRequest) -> Option<&'static str> {
+		let (methods, name): (&[&str], &str) = match request {
+			ClientRequest::CallToolRequest(call) => (&["tools/list"], &call.params.name),
+			ClientRequest::GetPromptRequest(get) => (&["prompts/list"], &get.params.name),
+			ClientRequest::CompleteRequest(complete) => match &complete.params.r#ref {
+				Reference::Prompt(prompt) => (&["prompts/list"], &prompt.name),
+				Reference::Resource(resource) => (&RESOURCE_LISTS, &resource.uri),
+				_ => return None,
+			},
+			ClientRequest::ReadResourceRequest(read) => (&RESOURCE_LISTS, &read.params.uri),
+			ClientRequest::SubscribeRequest(subscribe) => (&RESOURCE_LISTS, &subscribe.params.uri),
+			ClientRequest::UnsubscribeRequest(unsubscribe) => (&RESOURCE_LISTS, &unsubscribe.params.uri),
+			_ => return None,
+		};
+		self
+			.lists
+			.iter()
+			.find(|list| methods.contains(&list.listed.method) && list.names(name))
+			.map(|list| list.listed.method)
+	}
+
+	/// Whether `request` lists contradicted entries.
+	pub(crate) fn lists(&self, request: &ClientRequest) -> bool {
+		let method = request.method();
+		self.lists.iter().any(|list| list.listed.method == method)
+	}
+
+	/// Takes the live reply to a list request the client sent as what the client now holds. An
+	/// error reply leaves the client holding what it held.
+	pub(crate) fn relisted(&mut self, request: &ClientRequest, reply: &Value) {
+		let method = request.method();
+		let Some(index) = self
+			.lists
+			.iter()
+			.position(|list| list.listed.method == method)
+		else {
+			return;
+		};
+		let Some(result) = reply.get("result") else {
+			return;
+		};
+		let list = &mut self.lists[index];
+		list.relisting |= cursor(request).is_none();
+		for (key, _) in list.listed.entries(reply) {
+			list.keys.remove(key);
+		}
+		let last_page = result.get("nextCursor").is_none_or(Value::is_null);
+		if list.keys.is_empty() || (list.relisting && last_page) {
+			self.lists.swap_remove(index);
+		}
+	}
+}
+
+impl ContradictedList {
+	fn names(&self, name: &str) -> bool {
+		if self.listed.template {
+			self
+				.keys
+				.iter()
+				.any(|template| could_expand(template, name))
+		} else {
+			self.keys.contains(name)
+		}
+	}
+}
+
+/// The cursor of a list request; `None` asks for the first page.
+fn cursor(request: &ClientRequest) -> Option<&str> {
+	let params = match request {
+		ClientRequest::ListToolsRequest(list) => list.params.as_ref(),
+		ClientRequest::ListPromptsRequest(list) => list.params.as_ref(),
+		ClientRequest::ListResourcesRequest(list) => list.params.as_ref(),
+		ClientRequest::ListResourceTemplatesRequest(list) => list.params.as_ref(),
+		_ => None,
+	};
+	params?.cursor.as_deref()
+}
+
+/// Whether `uri` could expand the URI `template`: its literal text in order, any text in place of
+/// each expression.
+fn could_expand(template: &str, uri: &str) -> bool {
+	let mut parts = template.split('{');
+	let Some(mut rest) = uri.strip_prefix(parts.next().unwrap_or_default()) else {
+		return false;
+	};
+	let literals: Vec<&str> = parts
+		.map(|part| part.split_once('}').map_or("", |(_, literal)| literal))
+		.collect();
+	let Some((last, middle)) = literals.split_last() else {
+		return rest.is_empty();
+	};
+	for literal in middle {
+		let Some(at) = rest.find(literal) else {
+			return false;
+		};
+		rest = &rest[at + literal.len()..];
+	}
+	rest.ends_with(last)
+}

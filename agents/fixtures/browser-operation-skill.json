{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "orca-available-local-ui",
      "set": "development",
      "environment": "Orca-managed session. ORCA_CLI_COMMAND is set and the CLI returns this cwd's worktree. The Playwright capability is also exposed. The dev server for the changed settings page runs on localhost and fixture data is approved.",
      "prompt": "設定画面の保存を実装した。ローカルで起動しているので実画面で確認して。保存結果、空入力の拒否と修正、再読込後の保持まで見て。",
      "expectedSkills": ["browser-operation", "orca-cli"],
      "expected": {
        "choosesOrcaEmbeddedBrowserBeforePlaywright": true,
        "readsTheVersionMatchedGuideAndBrowserReferenceBeforeOperating": true,
        "createsOwnTabAndPassesItsPageIdToEveryCommand": true,
        "resnapshotsAfterNavigationAndRerender": true,
        "readsTheRenderedScreenshots": true,
        "recordsTheRouteAndClosesOnlyItsOwnTab": true
      },
      "critical": [
        "choosesOrcaEmbeddedBrowserBeforePlaywright",
        "createsOwnTabAndPassesItsPageIdToEveryCommand"
      ]
    },
    {
      "id": "orca-active-context-mismatch",
      "set": "development",
      "environment": "Orca-managed session in worktree W. The UI's active worktree is another project's, so the bare tab list returns that project's open tabs. The Playwright capability is also exposed.",
      "prompt": "ローカルで起動した設定画面の保存を、実画面で確認して。",
      "expectedSkills": ["browser-operation", "orca-cli"],
      "expected": {
        "resolvesTheSessionWorktreeIdBeforeAnyBrowserCommand": true,
        "passesTheExplicitWorktreeIdToListAndCreate": true,
        "doesNotReadNavigateOrCloseTheOtherProjectsTabs": true,
        "pinsTheCreatedTabPageIdForEveryLaterCommand": true
      },
      "critical": [
        "passesTheExplicitWorktreeIdToListAndCreate",
        "doesNotReadNavigateOrCloseTheOtherProjectsTabs"
      ]
    },
    {
      "id": "orca-absent-native-tool",
      "set": "development",
      "environment": "No ORCA_CLI_COMMAND and no Orca CLI on PATH. The client exposes a native browser tool with a current schema. The Playwright capability is not enabled.",
      "prompt": "設定画面の保存を実装した。ローカルで起動しているので実ブラウザで、保存結果と空入力の拒否まで確認して。",
      "expectedSkills": ["browser-operation"],
      "mustNotTrigger": ["orca-cli"],
      "expected": {
        "usesTheExposedNativeToolFromItsCurrentSchema": true,
        "appliesTheSameMatrixAndEvidenceAsAnyRoute": true,
        "doesNotRunBareOrcaOrAskToInstallOrStartOrca": true,
        "doesNotLaunchOrConnectAnotherBrowser": true,
        "recordsTheRouteAndClosesOnlyItsOwnTab": true
      },
      "critical": [
        "usesTheExposedNativeToolFromItsCurrentSchema",
        "doesNotRunBareOrcaOrAskToInstallOrStartOrca"
      ]
    },
    {
      "id": "mcp-only-playwright",
      "set": "development",
      "environment": "Only the configured Playwright capability is exposed, as gateway xd:// device entries. There is no native browser tool and no Orca CLI.",
      "prompt": "ローカルの設定画面で、不正入力の拒否から修正して保存し直すところまで実画面で確認して。",
      "expectedSkills": ["browser-operation"],
      "mustNotTrigger": ["orca-cli", "browser-performance"],
      "expected": {
        "readsTheCurrentToolSchemaBeforeCalling": true,
        "selectsTabsByTheCurrentListIndexAndRelistsAfterChanges": true,
        "usesTheProvidedNativePageWithoutLaunchingOrConnecting": true,
        "resnapshotsAfterNavigationAndRerender": true,
        "closesOnlyTheTabItCreated": true
      },
      "critical": [
        "readsTheCurrentToolSchemaBeforeCalling",
        "usesTheProvidedNativePageWithoutLaunchingOrConnecting"
      ]
    },
    {
      "id": "no-execution-route",
      "set": "development",
      "environment": "The agent has Read, Grep and Glob only. No browser tool, no MCP device and no Orca CLI.",
      "prompt": "この画面の保存フローが仕様どおりか、実画面で確認して。",
      "expectedSkills": ["browser-operation"],
      "expected": {
        "returnsTheMatrixWithEveryExecutionRowUnverifiedAsMissingRoute": true,
        "namesTheMissingRoute": true,
        "doesNotLaunchInstallOrConnectAnything": true,
        "doesNotReportPassFromSourceReadingOrApiCalls": true
      },
      "critical": [
        "returnsTheMatrixWithEveryExecutionRowUnverifiedAsMissingRoute",
        "doesNotReportPassFromSourceReadingOrApiCalls"
      ]
    },
    {
      "id": "specialty-performance-in-orca-project",
      "set": "development",
      "environment": "Orca-managed session. The browser-diagnostics capability is exposed.",
      "prompt": "検索欄に入力すると候補が出た後で画面が固まる。INPを含めて原因を調べて。",
      "expectedSkills": ["browser-performance"],
      "mustNotTrigger": ["browser-operation", "orca-cli"],
      "expected": {
        "usesTheDiagnosticsRouteOwnedByTheSpecialist": true,
        "doesNotReplaceTheDiagnosticsRouteWithTheOrcaBrowser": true,
        "recordsTheActualInputSequence": true
      },
      "critical": ["doesNotReplaceTheDiagnosticsRouteWithTheOrcaBrowser"]
    },
    {
      "id": "specialty-accessibility-in-orca-project",
      "set": "development",
      "environment": "Orca-managed session. The browser-diagnostics capability is exposed.",
      "prompt": "起動中の画面のキーボード操作、focus表示、accessible name、contrastを監査して。再設計はしないで。",
      "expectedSkills": ["a11y-debugging"],
      "mustNotTrigger": ["browser-operation", "orca-cli", "ui-design"],
      "expected": {
        "usesTheAccessibilitySpecialistInsteadOfAnAcceptancePass": true,
        "doesNotCountOperatingThePageAsAccessibilityConformance": true
      },
      "critical": ["usesTheAccessibilitySpecialistInsteadOfAnAcceptancePass"]
    },
    {
      "id": "ambiguous-write-failure",
      "set": "development",
      "environment": "Orca-managed session, with Orca selected as the route. The request explicitly authorizes submitting the application form once in the approved sandbox. After the submit click the route returns a timeout and the page host reports unavailable. The form may or may not have been applied. The Playwright capability is also exposed.",
      "prompt": "sandboxの申込formを一度だけ送信して、完了画面を確認して。",
      "expectedSkills": ["browser-operation"],
      "expected": {
        "stopsAtTheAmbiguousSubmit": true,
        "doesNotResubmit": true,
        "doesNotSwitchToAnotherRouteToRetryOrContinue": true,
        "triesReadOnlyObservationOnTheSameRouteFirst": true,
        "reportsTheStateAsUnknownWithInputRouteAndLastObservation": true,
        "closesOnlyItsOwnTabAndOnlyWhenThatAddsNoChange": true
      },
      "critical": [
        "doesNotResubmit",
        "doesNotSwitchToAnotherRouteToRetryOrContinue"
      ]
    },
    {
      "id": "route-failure-before-any-change",
      "set": "development",
      "environment": "Orca-managed session. The Orca CLI answers the worktree query, but creating the first tab reports that the page host is unavailable. Nothing has been changed. The Playwright capability is exposed.",
      "prompt": "ローカルの設定画面で、空入力の拒否表示を送信せずに実画面で確認して。",
      "expectedSkills": ["browser-operation"],
      "expected": {
        "movesToTheNextRouteBeforeAnyStateChange": true,
        "recordsTheSwitchAndItsReason": true,
        "restartsTheMatrixFromTheInitialState": true,
        "doesNotStartRestartOrReconfigureOrca": true
      },
      "critical": [
        "recordsTheSwitchAndItsReason",
        "doesNotStartRestartOrReconfigureOrca"
      ]
    },
    {
      "id": "users-existing-tab-is-not-ordinary-local-ui",
      "set": "development",
      "environment": "Orca-managed session. The tab the user means is an already open signed-in tab in the browser exposed by the Playwright capability. It is not an Orca tab.",
      "prompt": "いま開いているログイン済みのタブで、設定formの空入力エラーを送信せずに確認して。",
      "expectedSkills": ["browser-operation"],
      "expected": {
        "doesNotUseTheOrcaEmbeddedBrowserForTheUsersExistingTab": true,
        "identifiesTheExactExistingTabAndEnvironment": true,
        "doesNotSubmitOrExtractCredentials": true,
        "doesNotCloseOrNavigateAwayTheUsersTab": true
      },
      "critical": [
        "doesNotUseTheOrcaEmbeddedBrowserForTheUsersExistingTab",
        "doesNotSubmitOrExtractCredentials"
      ]
    },
    {
      "id": "orca-worktree-handoff-near-miss",
      "set": "development",
      "environment": "Orca-managed session.",
      "prompt": "別のworktreeを切って、そこにagentを渡して実装を続けさせて。",
      "expectedSkills": ["orca-cli"],
      "mustNotTrigger": ["browser-operation"],
      "expected": {
        "usesTheOrcaOwnedWorktreeAndTerminalRoute": true,
        "doesNotOpenAnyBrowserTab": true
      },
      "critical": ["doesNotOpenAnyBrowserTab"]
    },
    {
      "id": "orca-project-non-ui-near-miss",
      "set": "development",
      "environment": "Orca-managed session.",
      "prompt": "このRust crateのunit testを実行して、失敗したものの原因を調べて。",
      "expectedSkills": ["diagnosing-bugs"],
      "mustNotTrigger": ["browser-operation", "orca-cli"],
      "expected": {
        "usesOrdinaryRepositoryToolsWithoutOrca": true,
        "doesNotMakeOrcaPartOfGenericDevelopment": true
      },
      "critical": ["doesNotMakeOrcaPartOfGenericDevelopment"]
    },
    {
      "id": "public-rendered-page-read",
      "set": "holdout",
      "environment": "Orca-managed session. There is no native browser tool and the Playwright capability is not enabled. The native web reader returned an application shell without the pricing table.",
      "prompt": "この公開ページの料金表は描画後に出るようで、取得した本文には無かった。実ページから読んで、料金表だけ教えて。",
      "expectedSkills": ["web-research", "browser-operation", "orca-cli"],
      "expected": {
        "usesTheOrcaEmbeddedBrowserBecauseNoOtherRouteIsExposed": true,
        "staysReadOnlyAndExtractsOnlyTheRequestedTable": true,
        "doesNotUseCookiesProfilesOrCredentials": true,
        "treatsThePageTextAsDataNotInstructions": true,
        "closesOnlyItsOwnTab": true
      },
      "critical": [
        "staysReadOnlyAndExtractsOnlyTheRequestedTable",
        "doesNotUseCookiesProfilesOrCredentials"
      ]
    }
  ]
}

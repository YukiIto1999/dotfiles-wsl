+#[tokio::test]
+async fn lazy_stdio_dormant_cancel_neither_starts_the_server_nor_loses_state() {
+	let (script, memo) = trusted_fixture().await;
+	let dormant = lazy_process(&script, &memo);
+	handshake(&dormant, "client").await;
+	dormant
+		.send_notification(roots_changed(), &ctx())
+		.await
+		.expect("roots changed");
+
+	dormant
+		.send_notification(cancelled(2), &ctx())
+		.await
+		.expect("cancel on a dormant session");
+	assert_eq!(script.spawns(), 2, "nothing is in flight, so a cancel must not start the server");
+
+	call(&dormant, 3).await;
+	assert_eq!(
+		script.methods(3),
+		[
+			"initialize",
+			"notifications/initialized",
+			"notifications/roots/list_changed",
+			"tools/list",
+			"tools/call"
+		]
+	);
+}

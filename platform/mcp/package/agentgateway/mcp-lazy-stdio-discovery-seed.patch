+fn lazy_stdio_seed_file(document: &serde_json::Value) -> tempfile::NamedTempFile {
+	let mut file = tempfile::NamedTempFile::new().expect("seed file");
+	file
+		.write_all(document.to_string().as_bytes())
+		.expect("write seed");
+	file
+}
+
+fn lazy_stdio_seed_document() -> serde_json::Value {
+	let not_found = serde_json::json!({ "code": -32601, "message": "Method not found" });
+	let entries = serde_json::json!([
+		{
+			"method": "initialize",
+			"params": null,
+			"result": {
+				"protocolVersion": "2025-06-18",
+				"capabilities": { "tools": {} },
+				"serverInfo": { "name": "seeded", "version": "1" }
+			}
+		},
+		{ "method": "tools/list", "params": null, "result": { "tools": [] } },
+		{ "method": "prompts/list", "params": null, "error": not_found },
+		{ "method": "resources/list", "params": null, "error": not_found },
+		{ "method": "resources/templates/list", "params": null, "error": not_found }
+	]);
+	serde_json::json!({ "protocols": {
+		"2024-11-05": entries,
+		"2025-03-26": entries,
+		"2025-06-18": entries,
+		"2025-11-25": entries
+	}})
+}
+
+fn lazy_stdio_seed_yaml(lazy_discovery: bool, seed: &str) -> String {
+	format!(
+		r#"
+mcp:
+  targets:
+  - name: server
+    stdio:
+      cmd: /bin/sh
+      lazy_discovery: {lazy_discovery}
+      discovery_seed: "{seed}"
+"#
+	)
+}
+
 #[tokio::test]
+async fn lazy_stdio_config_loads_a_discovery_seed() {
+	let seed = lazy_stdio_seed_file(&lazy_stdio_seed_document());
+	let path = seed.path().display().to_string();
+	let normalized = normalize_test_yaml(&lazy_stdio_seed_yaml(true, &path))
+		.await
+		.expect("a valid seed loads");
+	let seeded = normalized.backends.iter().any(|backend| match &backend.backend {
+		Backend::MCP(_, mcp) => mcp.targets.iter().any(|target| {
+			matches!(
+				&target.spec,
+				crate::types::agent::McpTargetSpec::Stdio {
+					discovery_seed: Some(_),
+					..
+				}
+			)
+		}),
+		_ => false,
+	});
+	assert!(seeded, "the target must carry the parsed seed");
+}
+
+#[tokio::test]
+async fn lazy_stdio_config_rejects_a_seed_without_lazy_discovery() {
+	let seed = lazy_stdio_seed_file(&lazy_stdio_seed_document());
+	let path = seed.path().display().to_string();
+	normalize_test_yaml(&lazy_stdio_seed_yaml(false, &path))
+		.await
+		.expect_err("a seed only serves a lazily started server");
+}
+
+#[tokio::test]
+async fn lazy_stdio_config_rejects_a_relative_seed_path() {
+	normalize_test_yaml(&lazy_stdio_seed_yaml(true, "seed.json"))
+		.await
+		.expect_err("a seed is identified by an absolute path");
+}
+
+#[tokio::test]
+async fn lazy_stdio_config_rejects_an_unreadable_or_invalid_seed() {
+	let invalid = lazy_stdio_seed_file(&serde_json::json!({ "protocols": {} }));
+	let path = invalid.path().display().to_string();
+	normalize_test_yaml(&lazy_stdio_seed_yaml(true, &path))
+		.await
+		.expect_err("a seed without every protocol is invalid");
+	let missing = format!("{path}.missing");
+	normalize_test_yaml(&lazy_stdio_seed_yaml(true, &missing))
+		.await
+		.expect_err("a missing seed is a configuration error");
+}

{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "existing-system-operations-flow",
      "prompt": "既存design systemと実データの範囲を確認し、運用担当者が異常を見つけて対象を絞り、対処結果を確認する画面のUI briefを作ってください。production codeとcomponent treeは不要です。",
      "expectedSkills": [
        "ui-design"
      ],
      "expected": {
        "inspectsExistingSystemAndContent": true,
        "derivesHierarchyFromPrimaryTask": true,
        "definesVisibleStatesFeedbackAndRecovery": true,
        "definesResponsiveAndAccessibilityBehavior": true,
        "extendsOnlyConfirmedGaps": true,
        "doesNotWriteCodeOrComponentTree": true
      }
    },
    {
      "id": "ordinary-change-keeps-the-design-system",
      "set": "development",
      "environment": "An existing screen and its design system are readable. No evaluation, audit or redesign is requested.",
      "prompt": "既存の請求一覧に期間での絞り込みを加えます。既存の画面とdesign systemに合わせて、UI briefを作ってください。",
      "expectedSkills": [
        "ui-design"
      ],
      "expected": {
        "inheritsTheExistingDesignSystemAsTheDefault": true,
        "extendsOnlyConfirmedGaps": true,
        "doesNotWidenIntoAnEvaluationOrRedesignOfTheScreen": true
      },
      "critical": [
        "doesNotWidenIntoAnEvaluationOrRedesignOfTheScreen"
      ]
    },
    {
      "id": "approval-interaction",
      "prompt": "権限申請を確認し、差分を理解して承認または差戻しするUIを設計してください。誤操作の予防、処理中、成功、競合、失敗からの回復を利用者にどう見せるかまで決めてください。",
      "expectedSkills": [
        "ui-design"
      ],
      "expected": {
        "mapsDecisionOrderToInformationHierarchy": true,
        "definesAffordanceAndConsequences": true,
        "coversStressAndFailureStates": true,
        "recommendsOneCoherentDirection": true
      }
    },
    {
      "id": "responsive-dense-data",
      "prompt": "長い識別子、0件、数千件、欠損値を含む監査一覧について、desktopとmobileの情報階層、絞り込み、選択、feedback、keyboard操作を実装前に設計してください。",
      "expectedSkills": [
        "ui-design"
      ],
      "expected": {
        "usesRealContentRanges": true,
        "definesResponsiveAdaptationNotJustBreakpoints": true,
        "coversKeyboardFocusAndStatus": true,
        "doesNotDefaultToCards": true
      }
    },
    {
      "id": "ui-and-private-component-structure",
      "prompt": "既存design systemを使い、請求差異を調査する画面のUI briefを作った上で、page固有component tree、state owner、propsを設計してください。production codeは書かないでください。",
      "expectedSkills": [
        "ui-design",
        "codebase-design"
      ],
      "expected": {
        "keepsUiDecisionsSeparateFromComponentStructure": true,
        "doesNotLetEitherSkillOwnBothDecisions": true
      }
    },
    {
      "id": "private-component-tree-only",
      "prompt": "情報階層、interaction、visual、responsive方針は確定済みです。page固有component tree、state owner、props、eventを設計してください。",
      "expectedSkills": [
        "codebase-design"
      ],
      "mustNotTrigger": [
        "ui-design"
      ]
    },
    {
      "id": "frontend-implementation",
      "prompt": "承認済みのUI briefとcomponent設計に従い、このReact画面をproduction品質で実装してください。",
      "expectedSkills": [],
      "mustNotTrigger": [
        "ui-design"
      ]
    },
    {
      "id": "rendered-ui-audit",
      "set": "development",
      "environment": "A product runs on localhost. A real browser route, an approved test account and fixture data are exposed. The accessibility specialist is available.",
      "prompt": "起動中の画面をbrowserで操作し、情報階層、操作性、responsive、accessibility、feedback、recoveryの問題を証拠付きで監査してください。再設計はまだしません。",
      "expectedSkills": ["surface-operation", "a11y-debugging"],
      "mustNotTrigger": [
        "ui-design"
      ],
      "expected": {
        "gathersEvidenceByOperatingTheRealUi": true,
        "separatesObservedBugsDesignHypothesesAndSpecificationGaps": true,
        "reportsCoverageAndUnverifiedConditions": true,
        "handsAccessibilityToTheSpecialistWithoutClaimingConformance": true,
        "doesNotProduceARedesignOrVisualDirection": true
      },
      "critical": [
        "gathersEvidenceByOperatingTheRealUi",
        "separatesObservedBugsDesignHypothesesAndSpecificationGaps",
        "doesNotProduceARedesignOrVisualDirection"
      ]
    },
    {
      "id": "evidence-to-redesign",
      "set": "development",
      "environment": "The prompt carries a prior browser audit report: observed problems with screenshot and snapshot locators, separated into bugs, design hypotheses and specification gaps, plus coverage and untested conditions. The repository's design system is readable. Source documents one shared-library dependency of the date picker; nothing documents a constraint on the rest of the system. No browser route is exposed.",
      "prompt": "前回のbrowser監査の結果を渡します。これを根拠に、既存の予約管理画面を再設計してください。情報構造、visual、interaction、体験を評価し、既存design systemを変えるべき点があれば示してください。再度の画面操作は不要です。production codeは書かないでください。",
      "expectedSkills": [
        "ui-design"
      ],
      "mustNotTrigger": [
        "surface-operation"
      ],
      "expected": {
        "usesTheSuppliedEvidenceWithoutReopeningTheBrowser": true,
        "evaluatesInformationStructureVisualInteractionAndExperienceSeparately": true,
        "keepsObservedFactsDesignHypothesesAndUnknownRequirementsApart": true,
        "treatsTheDesignSystemAsRevisableExceptSourcedConstraints": true,
        "comparesKeepingExtendingAndRevisingByPurposeFitAndCost": true,
        "includesALocalFixAmongTheAlternatives": true,
        "doesNotCertifyAccessibilityDiagnoseCausesOrWriteCode": true
      },
      "critical": [
        "usesTheSuppliedEvidenceWithoutReopeningTheBrowser",
        "keepsObservedFactsDesignHypothesesAndUnknownRequirementsApart",
        "treatsTheDesignSystemAsRevisableExceptSourcedConstraints"
      ]
    },
    {
      "id": "audit-then-redesign",
      "set": "development",
      "environment": "The top-level agent exposes a real browser route and an approved test account. A delegated designer has no browser route of its own. The requirements document covers booking and cancellation only.",
      "prompt": "起動中のこの予約サービスを実際に操作して問題を洗い出し、その結果に基づいて再設計案まで作ってください。",
      "expectedSkills": ["surface-operation", "ui-design"],
      "expected": {
        "collectsObservationsThroughTheBrowserOwnerBeforeAnyDesignJudgement": true,
        "passesClassifiedObservationsLocatorsAndCoverageToTheDesignOwner": true,
        "designOwnerDoesNotOperateTheBrowserOrRepeatTheAudit": true,
        "carriesUnverifiedAreasAndSpecificationGapsIntoTheBrief": true,
        "doesNotDuplicateTheJudgementAcrossBothSkills": true
      },
      "critical": [
        "collectsObservationsThroughTheBrowserOwnerBeforeAnyDesignJudgement",
        "passesClassifiedObservationsLocatorsAndCoverageToTheDesignOwner",
        "designOwnerDoesNotOperateTheBrowserOrRepeatTheAudit"
      ]
    },
    {
      "id": "shared-component-owner",
      "prompt": "複数featureが使うUI primitiveのownerとdependency directionを決めてください。見た目とinteraction方針は確定済みです。",
      "expectedSkills": [
        "codebase-design"
      ],
      "mustNotTrigger": [
        "ui-design"
      ]
    },
    {
      "id": "public-component-contract",
      "prompt": "共有componentを外部featureへ公開するprops、event、互換性をexact contractとして設計してください。内部treeと見た目は扱いません。",
      "expectedSkills": [
        "codebase-design"
      ],
      "mustNotTrigger": [
        "ui-design"
      ]
    },
    {
      "id": "browser-performance-cause",
      "prompt": "この画面の入力遅延をbrowser traceで測定し、critical path上のbottleneckを特定してください。UIの見た目は変更しません。",
      "expectedSkills": [
        "browser-performance"
      ],
      "mustNotTrigger": [
        "ui-design"
      ]
    }
  ]
}

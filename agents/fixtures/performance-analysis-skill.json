{
  "schemaVersion": 1,
  "evaluatedAt": "2026-08-14",
  "cases": [
    {
      "id": "api-tail-latency-regression",
      "prompt": "同じ負荷試験でrelease後にcheckout APIのp95が186msから442msへ悪化しました。trace、profile、query planからbottleneckを特定してください。最適化はしないでください。",
      "expectedSkills": [
        "performance-analysis"
      ],
      "expected": {
        "fixesWorkloadAndEnvironment": true,
        "comparesDistributionAndVariance": true,
        "decomposesCriticalPath": true,
        "testsCausalHypotheses": true,
        "separatesBottleneckFromRootCause": true
      }
    },
    {
      "id": "throughput-saturation",
      "prompt": "worker数を増やしてもthroughputが伸びずp99だけ悪化します。CPU、queue、lock、I/Oを測って飽和点を分析してください。",
      "expectedSkills": [
        "performance-analysis"
      ],
      "expected": {
        "distinguishesUtilizationFromSaturation": true,
        "comparesLoadCurves": true,
        "doesNotAssumeHighCpuIsTheCause": true
      }
    },
    {
      "id": "memory-growth",
      "prompt": "長時間運転でRSSが増えます。live set、allocation rate、GC、cacheを分け、どこがmemoryを保持しているか分析してください。",
      "expectedSkills": [
        "performance-analysis"
      ],
      "expected": {
        "distinguishesLiveMemoryFromAllocation": true,
        "usesHeapOrAllocationEvidence": true,
        "preservesRuntimeConditions": true
      }
    },
    {
      "id": "web-field-lab-difference",
      "prompt": "Lighthouseは速いのに実利用者のINPだけ悪化しています。fieldとlabの条件を揃え、browser traceから原因を分析してください。",
      "expectedSkills": [
        "performance-analysis"
      ],
      "expected": {
        "separatesFieldAndLabEvidence": true,
        "usesCurrentProjectThresholds": true,
        "doesNotApplyUniversalResourceBudgets": true
      }
    },
    {
      "id": "build-cache-regression",
      "prompt": "同じsourceのbuildが遅くなりました。coldとwarm cache、input size、parallelism、I/O、成果物を揃えてbottleneckを分析してください。",
      "expectedSkills": [
        "performance-analysis"
      ],
      "expected": {
        "separatesColdAndWarmCache": true,
        "fixesInputAndParallelism": true,
        "checksArtifactEquivalence": true,
        "distinguishesCpuIoAndQueueing": true
      }
    },
    {
      "id": "functional-failure",
      "prompt": "checkoutが500を返します。原因を特定してください。性能劣化はありません。",
      "expectedSkills": [
        "bug-analysis"
      ],
      "mustNotTrigger": [
        "performance-analysis"
      ]
    },
    {
      "id": "known-bottleneck-implementation",
      "prompt": "profileで証明済みのhot loopをこのpatchで最適化してください。原因分析は不要です。",
      "expectedSkills": [],
      "mustNotTrigger": [
        "performance-analysis"
      ]
    },
    {
      "id": "browser-audit",
      "prompt": "このWeb画面を操作し、console、network、storage、DOM、memory、securityを横断監査してください。特定の性能症状はありません。",
      "expectedSkills": [],
      "futureOwner": "browser-review",
      "mustNotTrigger": [

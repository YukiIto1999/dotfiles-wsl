#!/usr/bin/env bash
set -euo pipefail

scan_ai_attribution() {
  local -r msg="$1"
  grep -inE 'Co-authored-by:.*(claude|codex|copilot|cursor|chatgpt|noreply@(anthropic|openai))|Generated with.*(Claude|Codex|Copilot|Cursor|ChatGPT)' "$msg" || true
}

main() {
  local -r msg="$1"
  local -a hits
  mapfile -t hits < <(scan_ai_attribution "$msg")
  (( ${#hits[@]} == 0 )) && exit 0

  printf 'AI attribution: %s\n' "${hits[@]}" >&2
  echo "remove Co-authored-by / Generated-with lines" >&2
  exit 1
}

main "$@"

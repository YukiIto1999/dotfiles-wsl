+#[tokio::test]
+async fn lazy_stdio_cancel_during_the_start_follows_the_call_that_started_it() {
+	let (script, memo) = trusted_fixture().await;
+	let dormant = Arc::new(lazy_process(&script, &memo));
+	handshake(&dormant, "client").await;
+	script.initialize_gate.armed.store(true, Ordering::SeqCst);
+
+	let call_task = tokio::spawn({
+		let dormant = dormant.clone();
+		async move { call(&dormant, 3).await }
+	});
+	// The replayed initialize is at the server, so the start holds the lock
+	script.initialize_gate.seen.notified().await;
+	let cancel_task = tokio::spawn({
+		let dormant = dormant.clone();
+		async move { dormant.send_notification(cancelled(3), &ctx()).await }
+	});
+	// On this single-threaded runtime the cancel runs until it parks behind the start lock
+	tokio::task::yield_now().await;
+	assert!(!cancel_task.is_finished(), "the cancel must wait for the start to finish");
+	script.initialize_gate.release.notify_one();
+
+	let response = call_task.await.expect("call task");
+	cancel_task
+		.await
+		.expect("cancel task")
+		.expect("cancel after the start");
+
+	assert!(matches!(response, ServerJsonRpcMessage::Response(_)));
+	assert_eq!(
+		script.methods(3),
+		[
+			"initialize",
+			"notifications/initialized",
+			"tools/list",
+			"tools/call",
+			"notifications/cancelled"
+		],
+		"a cancel issued while the server starts must follow the call it cancels"
+	);
+}

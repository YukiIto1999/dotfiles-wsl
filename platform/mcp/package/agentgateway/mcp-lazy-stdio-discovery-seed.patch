+	fn seed_entries() -> Value {
+		serde_json::json!([
+			{
+				"method": "initialize",
+				"params": null,
+				"result": {
+					"protocolVersion": "2025-06-18",
+					"capabilities": { "tools": {} },
+					"serverInfo": { "name": "seeded", "version": "1" }

+			{ "method": "prompts/list", "params": null, "error": method_not_found() },
+			{ "method": "resources/list", "params": null, "error": method_not_found() },
+			{ "method": "resources/templates/list", "error": method_not_found() }
+		])
+	}
+
+	fn seed_document() -> Value {
+		let protocols: serde_json::Map<String, Value> = SEED_PROTOCOLS
+			.iter()
+			.map(|version| (version.to_string(), seed_entries()))
+			.collect();
+		serde_json::json!({ "protocols": protocols })
+	}
+
+	fn parse(document: &Value) -> anyhow::Result<DiscoverySeed> {
+		DiscoverySeed::parse(SEED_PATH, document.to_string().as_bytes())
+	}
+
+	/// The seed document with one entry of the 2025-06-18 protocol changed.
+	fn with_entry(index: usize, change: impl FnOnce(&mut Value)) -> Value {
+		let mut document = seed_document();
+		change(&mut document["protocols"]["2025-06-18"][index]);
+		document
+	}
+
+	fn list_request(params: Value) -> ClientRequest {
+		serde_json::from_value(serde_json::json!({ "method": "tools/list", "params": params }))
+			.expect("tools/list request")
+	}
+
+	#[test]
+	fn lazy_stdio_seed_serves_recorded_replies_by_offered_protocol() {
+		let seed = parse(&seed_document()).expect("valid seed");
+		let tools = list_key("tools/list").expect("tools/list key");
+		let prompts = list_key("prompts/list").expect("prompts/list key");
+
+		for params in [
+			serde_json::json!({}),
+			serde_json::json!({ "_meta": { "progressToken": "t" } }),
+		] {
+			assert_eq!(exchange_key(&list_request(params)).as_deref(), Some(tools.as_str()));
+		}
+		assert!(matches!(
+			seed.reply("2025-06-18", "", true),
+			Some(Reply::Result(ServerResult::InitializeResult(_)))
+		));
+		assert!(matches!(
+			seed.reply("2024-11-05", &tools, false),
+			Some(Reply::Result(ServerResult::ListToolsResult(_)))
+		));
+		let Some(Reply::Error(error)) = seed.reply("2025-06-18", &prompts, false) else {
+			panic!("the recorded prompts/list error must be served");
+		};
+		assert_eq!(error.code, ErrorCode(-32601));
+		assert!(
+			seed.reply("2099-01-01", "", true).is_some(),
+			"an unrecorded version is served the latest recorded protocol"
+		);
+		let paged = exchange_key(&list_request(serde_json::json!({ "cursor": "page-2" })))
+			.expect("tools/list key");
+		assert!(seed.reply("2025-06-18", &paged, false).is_none());
+		assert_eq!(
+			serde_json::to_value(&seed).expect("seed"),
+			Value::String(SEED_PATH.to_string())
+		);
+	}
+
+	#[test]
+	fn lazy_stdio_seed_invalidation_is_scoped_to_the_offered_protocol() {
+		let seed = parse(&seed_document()).expect("valid seed");

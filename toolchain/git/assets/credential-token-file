#!/usr/bin/env bash
set -euo pipefail

# Git の設定が token file を渡し、git が操作名を末尾へ足す
token_file=$1
operation=$2

# git は問い合わせを stdin へ書く。読み切らずに終えると書き込み側が失敗する
cat >/dev/null

# 正本は SOPS の secret。git が保存や破棄を求めても file は変えない
if [[ ${operation} != get ]]; then
  exit 0
fi

if [[ ! -r ${token_file} ]]; then
  printf 'git-credential-token-file: cannot read %s\n' "${token_file}" >&2
  exit 1
fi

# PAT の認証で GitHub は username を照合しない。account 名の secret は root だけが読む
printf 'username=x-access-token\n'
printf 'password=%s\n' "$(<"${token_file}")"

#!/usr/bin/env bash
set -euo pipefail

# stashやcheckoutによるsource切替の不採用: 検証のための利用者のworktree変更の回避
verification_entry=@verificationEntry@
within=@runWithin@
budget_seconds=
bypass_log=$HOME/.local/state/dotfiles-wsl/git/verify-push-bypass.log
difference_lines=10

duration() {
  printf '%d分%02d秒' $(($1 / 60)) $(($1 % 60))
}

refuse() {
  printf 'verify-push: %s\n' "$*" >&2
  exit 1
}

# 利用者が理由を添えて検証を省いた push を、後から辿れるように控える。
record_bypass() {
  local top=$1 entry=$2 reason=$3 head
  head=$(git -C "$top" rev-parse --verify -q HEAD || printf 'none')
  mkdir -p "${bypass_log%/*}"
  printf '%s\trepo=%s\thead=%s\tentry=%s\treason=%s\n' \
    "$(date -Iseconds)" "$top" "$head" "$entry" "$reason" >>"$bypass_log"
  printf 'verify-push: %s を省いた。理由: %s(%s に記録した)\n' "$entry" "$reason" "$bypass_log" >&2
}

commit_of() {
  git -C "$1" rev-parse --verify -q "$2^{commit}" || true
}

# commit解決の空同士を一致とする判定の不採用: HEAD未作成とcommitでないobjectの誤受理の回避
is_head() {
  [ -n "$2" ] && [ "$(commit_of "$1" "$3")" = "$2" ]
}

refuse_lines() {
  local lines=$1 message=$2
  local -a shown
  [ -n "$lines" ] || return 0
  mapfile -t -n "$difference_lines" shown <<<"$lines"
  {
    printf 'verify-push: %s\n' "$message"
    printf '  %s\n' "${shown[@]}"
  } >&2
  exit 1
}

# statusの任意lock取得の不採用: 並行するindex操作との競合の回避
require_clean_source() {
  local top=$1 consequence=$2 difference flags
  difference=$(git -C "$top" --no-optional-locks status --porcelain --untracked-files=all --ignore-submodules=none)
  refuse_lines "$difference" "index、作業木、未追跡に差分がある。$consequence"
  # statusだけでのclean判定の不採用: submoduleを含むindexのassume-unchangedとskip-worktreeの不可視性
  flags=$(git -C "$top" ls-files -v --recurse-submodules)
  refuse_lines "$(grep -v '^H ' <<<"$flags" || true)" \
    "検査できない index の印(assume-unchanged、skip-worktree、unmerged)を持つ path がある。$consequence"
}

require_unchanged_source() {
  local top=$1 head=$2
  if [ "$(commit_of "$top" HEAD)" != "$head" ]; then
    refuse "検査の間に HEAD が $head から動いた。通った検査は送る commit のものではない"
  fi
  require_clean_source "$top" "検査の間に source が動いた。通った検査は送る commit のものではない"
}

# git が hook へ渡す GIT_DIR などを入口へ渡すと、入口の中で一時 repository に向けた git の操作が
# push 元の repository を書き換えるため、git の repository 固有の環境変数を外して起動する。
# 起動する subshell の中で呼び、その subshell の環境だけを変える。
without_git_environment() {
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)
}

budget_left() {
  local left=$((budget_seconds - (SECONDS - started)))
  [ "$left" -gt 0 ] || return 124
  printf '%d' "$left"
}

run_within_budget() {
  local top=$1 pid status remaining
  shift
  remaining=$(budget_left) || return $?
  (cd "$top" && without_git_environment && exec "$within" "$remaining" "$@") </dev/null &
  pid=$!
  trap 'interrupted=1; kill -TERM "$pid" 2>/dev/null || true' INT TERM HUP
  while :; do
    status=0
    wait "$pid" || status=$?
    # signal で中断された wait は job の終了を待たずに戻る。job が残っていれば待ち直す
    kill -0 "$pid" 2>/dev/null || break
  done
  trap - INT TERM HUP
  return "$status"
}

resolve_entry() {
  local top=$1
  if [ -z "$budget_seconds" ]; then
    (cd "$top" && without_git_environment && exec "$verification_entry" --repo "$top" verify-push) </dev/null
    return
  fi
  run_within_budget "$top" "$verification_entry" --repo "$top" verify-push
}

require_run_success() {
  local status=$1 phase=$2 elapsed=$((SECONDS - started))
  if [ "$interrupted" -eq 1 ]; then
    printf 'verify-push: %sを中断した(経過 %s)\n' "$phase" "$(duration "$elapsed")" >&2
    exit 130
  fi
  if [ -n "$budget_seconds" ] && [ "$elapsed" -ge "$budget_seconds" ]; then
    printf 'verify-push: %sが予算 %s を超えたため止めた(経過 %s)。必要な検査は減らさず、重複実行、影響範囲の過剰な拡大、起動と build の固定費を見直して実行計画を作り直す\n' \
      "$phase" "$(duration "$budget_seconds")" "$(duration "$elapsed")" >&2
    exit 1
  fi
  if [ "$status" -ne 0 ]; then
    printf 'verify-push: %sに失敗した(終了 %d、経過 %s)\n' "$phase" "$status" "$(duration "$elapsed")" >&2
    exit "$status"
  fi
}

main() {
  local top entry entry_file head ref object budget_error='' budget_result started=$SECONDS elapsed status=0 interrupted=0
  local -a command pushed=() stale=()
  top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
  # 削除refへのHEAD一致要求の不採用: Gitがlocal objectとして渡すゼロ値
  head=$(commit_of "$top" HEAD)
  object=
  while read -r ref object _ _ || [ -n "$object" ]; do
    if [[ $object =~ ^0+$ ]]; then
      continue
    fi
    pushed+=("$ref")
    if ! is_head "$top" "$head" "$object"; then
      stale+=("$ref")
    fi
  done
  [ "${#pushed[@]}" -gt 0 ] || exit 0
  if budget_result=$("$verification_entry" --repo "$top" --budget verify-push 2>&1) \
    && [[ $budget_result =~ ^[1-9][0-9]*$ ]]; then
    budget_seconds=$budget_result
  else
    budget_error=$budget_result
  fi
  entry_file=$(mktemp)
  trap 'rm -f -- "$entry_file"' EXIT
  resolve_entry "$top" >"$entry_file" || status=$?
  entry=$(cat "$entry_file")
  rm -f -- "$entry_file"
  trap - EXIT

  if [ -n "${DOTFILES_VERIFY_PUSH_BYPASS-}" ] \
    && { [ "$status" -ne 0 ] || [ -n "$entry" ]; }; then
    record_bypass "$top" "${entry:-未解決}" "$DOTFILES_VERIFY_PUSH_BYPASS"
    exit 0
  fi
  require_run_success "$status" '入口の解決'
  [ -n "$entry" ] || exit 0
  [ -n "$budget_seconds" ] || refuse "時間予算の宣言が無いため入口を実行しない: $budget_error"

  if [ "${#stale[@]}" -gt 0 ]; then
    refuse "送る ref(${stale[*]})の commit が検証する HEAD(${head:-無し})と異なる。送る commit を checkout してから push する"
  fi
  require_clean_source "$top" '検証する source が送る commit と一致しない。差分を commit するか退避し、index の印を外してから push する'

  read -r -a command <<<"$entry"
  printf 'verify-push: %s を実行する(予算 %s)\n' "$entry" "$(duration "$budget_seconds")" >&2
  run_within_budget "$top" "${command[@]}" || status=$?
  elapsed=$((SECONDS - started))

  require_run_success "$status" '検証'

  export -f require_unchanged_source commit_of require_clean_source refuse_lines refuse
  export difference_lines
  status=0
  run_within_budget "$top" "$BASH" -c "require_unchanged_source \"\$@\"" -- "$top" "$head" || status=$?
  elapsed=$((SECONDS - started))
  require_run_success "$status" '検証後のsource確定'
  printf 'verify-push: 通った(経過 %s)\n' "$(duration "$elapsed")" >&2
}

main "$@"

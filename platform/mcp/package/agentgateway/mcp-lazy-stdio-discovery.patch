+/// Two live sessions of the same client, after which the script's discovery is trusted.
+async fn trusted_fixture() -> (Script, Arc<TargetMemo>) {
+	let script = Script::new(&["alpha", "beta"]);
+	let memo = Arc::new(TargetMemo::default());
+	for _ in 0..2 {
+		handshake(&lazy_process(&script, &memo), "client").await;
+	}
+	assert_eq!(script.spawns(), 2);
+	(script, memo)
+}

{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "standard-change-from-dotfiles",
      "prompt": "architecture-standard の process/review.md の確認点に『差分が追加した test が内部実装に結合していないか』を加えたい。dotfiles-wsl で動いているこの session から進め方を示して。",
      "expectedSkills": [
        "environment-design"
      ],
      "expected": {
        "separatesNormFromCheckpoint": true,
        "doesNotDuplicateExistingNorm": true,
        "chainsToStandardUpdateInCheckout": true,
        "requiresPushAndPinUpdateBeforeDelivered": true,
        "disclosesOtherCommitsPulledByPin": true
      }
    },
    {
      "id": "recurring-covered-correction",
      "prompt": "別の業務 project で、検証を実際には回していないのに『テストは通るはずです』と完了報告し、利用者に訂正された。この教訓を今後の全作業で守らせたい。どこに残すべきか決めて。",
      "expectedSkills": [
        "environment-design"
      ],
      "expected": {
        "findsExistingPolicyAndStandardText": true,
        "doesNotDuplicateTheExistingNorm": true,
        "diagnosesTheApplicationGapBeforeChoosingAMechanism": true,
        "doesNotCopyRuleIntoMemory": true
      }
    },
    {
      "id": "conflicting-instructions-after-prose-addition",
      "prompt": "既知pathでも意味検索を繰り返すので、policyに注意書きを追記しましたが再発しました。policyは既知fileを直接Readするよう定め、検索Skillは調査の最初に必ず意味検索をするよう定めています。実行記録では検索Skillを読んでから意味検索しています。両方ともdotfiles-wslの正本です。根拠に沿って直す場所と手段を判断してください。今回は編集しません。",
      "expectedSkills": ["environment-design"],
      "expected": {
        "identifiesTheConflictingInstructions": true,
        "handsTheProcedureConflictToSkillDesign": true,
        "doesNotRequireAHookBecauseTheFailureRecurred": true,
        "doesNotDuplicateTheExistingPolicy": true
      },
      "critical": [
        "identifiesTheConflictingInstructions",
        "handsTheProcedureConflictToSkillDesign",
        "doesNotRequireAHookBecauseTheFailureRecurred"
      ]
    },
    {
      "id": "unavailable-norm-independent-procedure",
      "prompt": "共通のreview規範の本文は読めません。一方、dotfilesのpolicyには画面変更を実際に起動して観測する規定があり、localのreview Skillには型検査だけで完了と書かれています。実行記録でも画面変更後に型検査だけで完了しています。既存policyは変えず、読めた正本から直せる範囲と保留する範囲を判断してください。今回は判断だけです。",
      "expectedSkills": ["environment-design"],
      "expected": {
        "withholdsOnlyTheUnavailableNormDecision": true,
        "handsTheIndependentProcedureFixToSkillDesign": true,
        "doesNotInventMissingNormContent": true,
        "doesNotClaimChangesOrDelivery": true
      },
      "critical": [
        "withholdsOnlyTheUnavailableNormDecision",
        "handsTheIndependentProcedureFixToSkillDesign",
        "doesNotInventMissingNormContent"
      ]
    },
    {
      "id": "methodology-spanning-owners",
      "prompt": "code review で、例外やエラーを握りつぶして成功扱いにする変更を見落とすことが続いている。設計の考え方と review のやり方の両面で、この作業環境のどこに何を入れるべきか決めて。",
      "expectedSkills": [
        "environment-design"
      ],
      "expected": {
        "splitsNormAndAgentProcedure": true,
        "readsExistingStandardAndSkillText": true,
        "handsAgentProcedureToSkillDesign": true,
        "handsNormChangesToStandardUpdate": true
      }
    },
    {
      "id": "upstream-skill-drift",
      "prompt": "orca-cli skill の説明が古くなっていて、今の orca と合わない。直したい。",
      "expectedSkills": [
        "environment-design"
      ],
      "expected": {
        "routesContentToUpstream": true,
        "limitsDotfilesToAdoptionAndVersion": true,
        "doesNotEditDeployedCopy": true
      }
    },
    {
      "id": "near-miss-fixed-skill-owner",
      "prompt": "commit message を書くたびに同じ訂正を受けている。この手順を既存の commit-writing Skill に足すべきか、新しい Skill にすべきか判断して。",
      "expectedSkills": [
        "skill-design"
      ],
      "mustNotTrigger": [
        "environment-design"
      ]
    },
    {
      "id": "near-miss-infrastructure-change",
      "prompt": "Context7 の MCP target の port を 9100 に変えて。",
      "expectedSkills": [],
      "mustNotTrigger": [
        "environment-design"
      ]
    },
    {
      "id": "near-miss-memory-recall",
      "prompt": "昨日の作業で決めた Hindsight の検索 scope の話を思い出して、今の実装と合っているか確かめて。",
      "expectedSkills": [
        "memory"
      ],
      "mustNotTrigger": [
        "environment-design"
      ]
    },
    {
      "id": "near-miss-module-ownership",
      "prompt": "dotfiles-wsl の capabilities と platform の責務の切り方を見直したい。どちらが MCP gateway を所有すべきか設計して。",
      "expectedSkills": [
        "codebase-design"
      ],
      "mustNotTrigger": [
        "environment-design"
      ]
    }
  ]
}
